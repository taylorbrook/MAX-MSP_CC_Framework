      {
        "box": {
          "maxclass": "codebox",
          "id": "obj-2",
          "code": "// === PARAMETERS ===\nParam attack(10, min=0.1, max=5000);\nParam decay(100, min=0.1, max=5000);\nParam sustain(0.7, min=0, max=1);\nParam release(200, min=0.1, max=10000);\n\n// === STATE ===\nHistory env(0);\nHistory phase(0);\nHistory prev_gate(0);\n\n// === DSP ===\ngate = in1;\nsr = samplerate;\n\natt_coeff = exp(-1.0 / max(attack * sr * 0.001, 1));\ndec_coeff = exp(-1.0 / max(decay * sr * 0.001, 1));\nrel_coeff = exp(-1.0 / max(release * sr * 0.001, 1));\n\n// Retrigger on rising edge\nif (gate > 0 && prev_gate <= 0) {\n    phase = 1;\n}\n\n// Release on falling edge\nif (gate <= 0 && prev_gate > 0) {\n    phase = 4;\n}\n\nprev_gate = gate;\n\n// State machine: 0=idle, 1=attack, 2=decay, 3=sustain, 4=release\nif (phase == 1) {\n    env = 1.0 + att_coeff * (env - 1.0);\n    if (env >= 0.999) {\n        env = 1.0;\n        phase = 2;\n    }\n} else if (phase == 2) {\n    env = sustain + dec_coeff * (env - sustain);\n    if (abs(env - sustain) < 0.001) {\n        env = sustain;\n        phase = 3;\n    }\n} else if (phase == 3) {\n    env = sustain;\n} else if (phase == 4) {\n    env = rel_coeff * env;\n    if (env < 0.001) {\n        env = 0;\n        phase = 0;\n    }\n} else {\n    env = 0;\n}\n\nout1 = env;\n",
          "numinlets": 1,
          "numoutlets": 1,
          "outlettype": [
            ""
          ],
          "patching_rect": [
            50.0,
            80.0,
            400.0,
            200.0
          ],
          "fontname": "Arial",
          "fontsize": 12.0
        }
      },
