      {
        "box": {
          "maxclass": "codebox",
          "id": "obj-3",
          "code": "// === PARAMETERS ===\nParam decay(0.5, min=0, max=0.99);\nParam damping(0.5, min=0, max=1);\nParam drywet(0.3, min=0, max=1);\n\n// === STATE ===\nDelay comb1(1687);\nDelay comb2(1601);\nDelay comb3(2053);\nDelay comb4(2251);\nDelay ap1(556);\nDelay ap2(441);\nHistory damp1(0);\nHistory damp2(0);\nHistory damp3(0);\nHistory damp4(0);\n\n// === DSP ===\ndry_L = in1;\ndry_R = in2;\ninput_mix = (dry_L + dry_R) * 0.5;\n\n// 4 comb filters with damping\nc1 = comb1.read(1687);\ndamp1 = c1 + damping * (damp1 - c1);\ncomb1.write(input_mix + decay * damp1);\n\nc2 = comb2.read(1601);\ndamp2 = c2 + damping * (damp2 - c2);\ncomb2.write(input_mix + decay * damp2);\n\nc3 = comb3.read(2053);\ndamp3 = c3 + damping * (damp3 - c3);\ncomb3.write(input_mix + decay * damp3);\n\nc4 = comb4.read(2251);\ndamp4 = c4 + damping * (damp4 - c4);\ncomb4.write(input_mix + decay * damp4);\n\ncomb_sum = c1 + c2 + c3 + c4;\n\n// 2 allpass filters in series\na1_out = ap1.read(556);\nap1.write(comb_sum + 0.5 * a1_out);\nap1_result = a1_out - 0.5 * (comb_sum + 0.5 * a1_out);\n\na2_out = ap2.read(441);\nap2.write(ap1_result + 0.5 * a2_out);\nap2_result = a2_out - 0.5 * (ap1_result + 0.5 * a2_out);\n\nwet = ap2_result;\nout1 = dry_L + drywet * (wet - dry_L);\nout2 = dry_R + drywet * (wet - dry_R);\n",
          "numinlets": 2,
          "numoutlets": 2,
          "outlettype": [
            "",
            ""
          ],
          "patching_rect": [
            50.0,
            80.0,
            400.0,
            200.0
          ],
          "fontname": "Arial",
          "fontsize": 12.0
        }
