          "code": "// === PARAMETERS ===\nParam record(0, min=0, max=1);\nParam loop(0, min=0, max=1);\n\n// === STATE ===\nBuffer buf(\"bufname\");\nHistory pos(0);\n\n// === DSP ===\naudio_in = in1;\nbuf_len = dim(buf);\n\nif (record > 0.5) {\n    poke(buf, audio_in, pos);\n    pos = pos + 1;\n    if (pos >= buf_len) {\n        if (loop > 0.5) {\n            pos = 0;\n        } else {\n            pos = buf_len - 1;\n        }\n    }\n} else {\n    pos = 0;\n}\n\n// Output normalized position (0-1)\nout1 = pos / max(buf_len, 1);\n",
