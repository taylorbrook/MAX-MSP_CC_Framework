          "maxclass": "codebox",
          "id": "obj-1",
          "code": "// === PARAMETERS ===\nParam rate(10, min=0.1, max=1000);\nParam step_size(0.01, min=0.001, max=0.5);\nParam min_val(0, min=-1, max=1);\nParam max_val(1, min=-1, max=1);\n\n// === STATE ===\nHistory pos(0.5);\nHistory counter(0);\n\n// === DSP ===\nsr = samplerate;\nstep_interval = max(sr / rate, 1);\n\ncounter = counter + 1;\nif (counter >= step_interval) {\n    counter = 0;\n    // Random step\n    pos = pos + noise() * step_size;\n    // Clamp to bounds\n    pos = clamp(pos, min_val, max_val);\n}\n\nout1 = pos;\n",
