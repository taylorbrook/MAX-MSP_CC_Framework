# Local Max package source files copied for DB audits — never committed
.claude/max-objects/_pkg-source/

# Python build artifacts
__pycache__/
*.pyc
.pytest_cache/

# OS junk
.DS_Store

# Claude Code agent worktrees
.claude/worktrees/

# GSD runtime sentinels (per-run dispatch state, not project content)
.gsd/

# Per-checkout local state -- never committed (review B11, I2)
/patches/.active-project.json
/.claude/projects/

# MAX bridge temp copies (tools/max_bridge.py) -- never committed
__maxbridge_*

# GSD quick-task scratch (baselines, triage dumps, junit, helper scripts):
# only the .md deliverables are project content. Already-tracked files stay tracked.
/.planning/quick/*/*
!/.planning/quick/*/*.md

# Generated wavetable banks (~23 MB each) are derived data: regenerate, never commit (quick 261112-est).
# ji-harmonizer: python3 patches/ji-harmonizer/tools/render_wavetables.py --all
# terrain-synth: retired bake_geometry banks, covered so they cannot be re-added.
/patches/ji-harmonizer/generated/bank[0-9][0-9]-*.wav
/patches/terrain-synth/generated/bank[0-9][0-9]-*.wav
