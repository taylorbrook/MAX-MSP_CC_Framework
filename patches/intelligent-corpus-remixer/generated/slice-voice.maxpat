                                    "parameter_enable": 0,
                                    "code": "Param offset(0);\nParam duration(1);\nParam loopmode(0);\nParam trig(0);\nParam pan(0.5);\nParam gain(0.35);\nHistory phase(0);\nHistory running(0);\nHistory voiceage(0);\nHistory trig_prev(0);\nHistory one(1);\nBuffer source;\n\n// de-hoist: nothing below is Param-only\nsrs = samplerate * one;\nk_dur = duration * one;\nk_loop = loopmode * one;\nk_pan = pan * one;\nk_gain = gain * one;\n\ntrig_fire = abs(trig - trig_prev) > 0.5;\ncur_phase = trig_fire ? 0 : phase;\ncur_age = trig_fire ? 0 : voiceage;\ncur_running = trig_fire ? 1 : running;\n\n// loop crossfade: tail [xstart, dur) blends into head [0, xfade), then wraps to xfade\nlooping = k_loop > 0.5;\nfade_samples = 0.005 * srs;\nxfade = floor(min(fade_samples, k_dur * 0.5));\nxstart = k_dur - xfade;\nin_xfade = looping * (cur_phase >= xstart);\n\nnchans = channels(source);\nis_st = nchans > 1.5;\npos_a = offset + cur_phase;\na_l = peek(source, pos_a, 0);\na_r = peek(source, pos_a, 1);\ns_main = is_st ? (a_l + a_r) * 0.5 : a_l;\npos_b = offset + max(cur_phase - xstart, 0);\nb_l = peek(source, pos_b, 0);\nb_r = peek(source, pos_b, 1);\ns_head = is_st ? (b_l + b_r) * 0.5 : b_l;\nxt = in_xfade * min(1, (cur_phase - xstart) / max(xfade, 1));\ng_out = cos(xt * halfpi);\ng_in = sin(xt * halfpi);\nmixed = in_xfade ? (s_main * g_out + s_head * g_in) : s_main;\n\nnext_phase = cur_phase + 1;\npast_end = next_phase >= k_dur;\nwrap_to = looping ? xfade : k_dur;\nnew_phase = past_end ? wrap_to : next_phase;\nnext_running = (past_end * (1 - looping)) > 0.5 ? 0 : cur_running;\n\nfade_in_val = min(1, cur_age / fade_samples);\nremaining = max(k_dur - 1 - cur_phase, 0);\nfade_out_val = looping ? 1 : min(1, remaining / fade_samples);\nenv = cur_running * fade_in_val * fade_out_val * k_gain;\npanL = cos(k_pan * halfpi);\npanR = sin(k_pan * halfpi);\n\nphase = new_phase;\nrunning = next_running;\nvoiceage = cur_age + cur_running;\ntrig_prev = trig;\nout1 = mixed * env * panL;\nout2 = mixed * env * panR;\nout3 = next_running;\n",
