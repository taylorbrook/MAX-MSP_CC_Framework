    "boxes": [
      {
        "box": {
          "maxclass": "newobj",
          "text": "in 1",
          "id": "obj-1",
          "numinlets": 0,
          "numoutlets": 1,
          "outlettype": [
            ""
          ],
          "patching_rect": [
            50.0,
            20.0,
            30.0,
            22.0
          ],
          "fontname": "Arial",
          "fontsize": 12.0
        }
      },
      {
        "box": {
          "maxclass": "codebox",
          "id": "obj-2",
          "code": "// gen-eq engine v0.3.0\n// HPF -> Bell1 -> sat -> Bell2 -> sat -> Bell3 -> sat -> LPF -> sat -> DC block\n// HPF/LPF: true Butterworth 6/12/18/24 dB/oct, all four alignments run in\n// parallel and are crossfaded by the smoothed slope value (click-free).\n\n// === PARAMETERS ===\nParam hpf_freq(30, min=20, max=20000);\nParam hpf_slope(1, min=0, max=3);\nParam bell1_freq(200, min=20, max=20000);\nParam bell1_gain(0, min=-18, max=18);\nParam bell1_q(1, min=0.1, max=10);\nParam bell2_freq(1000, min=20, max=20000);\nParam bell2_gain(0, min=-18, max=18);\nParam bell2_q(1, min=0.1, max=10);\nParam bell3_freq(5000, min=20, max=20000);\nParam bell3_gain(0, min=-18, max=18);\nParam bell3_q(1, min=0.1, max=10);\nParam lpf_freq(18000, min=20, max=20000);\nParam lpf_slope(1, min=0, max=3);\nParam drive(1.0, min=0.1, max=5.0);\nParam bias(0.15, min=0.0, max=0.5);\n\n// === STATE ===\n// never written: keeps samplerate-derived setup inside the sample loop (no hoisting)\nHistory one(1);\n// HPF: one-pole + 12 dB SVF + 18 dB SVF + two 24 dB SVFs\nHistory h_op_z(0);\nHistory h12_ic1(0);\nHistory h12_ic2(0);\nHistory h18_ic1(0);\nHistory h18_ic2(0);\nHistory h24a_ic1(0);\nHistory h24a_ic2(0);\nHistory h24b_ic1(0);\nHistory h24b_ic2(0);\n// Bells\nHistory b1_ic1(0);\nHistory b1_ic2(0);\nHistory b2_ic1(0);\nHistory b2_ic2(0);\nHistory b3_ic1(0);\nHistory b3_ic2(0);\n// LPF: one-pole + 12 dB SVF + 18 dB SVF + two 24 dB SVFs\nHistory l_op_z(0);\nHistory l12_ic1(0);\nHistory l12_ic2(0);\nHistory l18_ic1(0);\nHistory l18_ic2(0);\nHistory l24a_ic1(0);\nHistory l24a_ic2(0);\nHistory l24b_ic1(0);\nHistory l24b_ic2(0);\n// DC blocker\nHistory dc_x1(0);\nHistory dc_y1(0);\n// Parameter smoothing\nHistory s_hpf_freq(30);\nHistory s_hpf_slope(1);\nHistory s_bell1_freq(200);\nHistory s_bell1_gain(0);\nHistory s_bell1_q(1);\nHistory s_bell2_freq(1000);\nHistory s_bell2_gain(0);\nHistory s_bell2_q(1);\nHistory s_bell3_freq(5000);\nHistory s_bell3_gain(0);\nHistory s_bell3_q(1);\nHistory s_lpf_freq(18000);\nHistory s_lpf_slope(1);\nHistory s_drive(1.0);\nHistory s_bias(0.15);\n\n// === SETUP ===\nsrs = samplerate * one;\ndnrm = 1e-18;\n// smoothing coefficients, samplerate-independent (~45 / 23 / 11 ms)\nc_freq = 22.05 / srs;\nc_gain = 44.1 / srs;\nc_slope = 88.2 / srs;\nf_max = 0.49 * srs;\n// Butterworth damping (k = 1/Q): 2-pole, 3-pole SVF section, 4-pole pair\nk12 = 1.41421356;\nk18 = 1.0;\nk24a = 1.84775907;\nk24b = 0.76536686;\n\n// === SMOOTH PARAMETERS ===\ns_hpf_freq = s_hpf_freq + (hpf_freq - s_hpf_freq) * c_freq;\ns_hpf_slope = s_hpf_slope + (hpf_slope - s_hpf_slope) * c_slope;\ns_bell1_freq = s_bell1_freq + (bell1_freq - s_bell1_freq) * c_freq;\ns_bell1_gain = s_bell1_gain + (bell1_gain - s_bell1_gain) * c_gain;\ns_bell1_q = s_bell1_q + (bell1_q - s_bell1_q) * c_gain;\ns_bell2_freq = s_bell2_freq + (bell2_freq - s_bell2_freq) * c_freq;\ns_bell2_gain = s_bell2_gain + (bell2_gain - s_bell2_gain) * c_gain;\ns_bell2_q = s_bell2_q + (bell2_q - s_bell2_q) * c_gain;\ns_bell3_freq = s_bell3_freq + (bell3_freq - s_bell3_freq) * c_freq;\ns_bell3_gain = s_bell3_gain + (bell3_gain - s_bell3_gain) * c_gain;\ns_bell3_q = s_bell3_q + (bell3_q - s_bell3_q) * c_gain;\ns_lpf_freq = s_lpf_freq + (lpf_freq - s_lpf_freq) * c_freq;\ns_lpf_slope = s_lpf_slope + (lpf_slope - s_lpf_slope) * c_slope;\ns_drive = s_drive + (drive - s_drive) * c_gain;\ns_bias = s_bias + (bias - s_bias) * c_gain;\n\n// === INPUT ===\nsig = in1;\n\n// === HPF ===\nhg = tan(pi * min(s_hpf_freq, f_max) / srs);\n// 6 dB/oct one-pole\nh_op_v = (sig - h_op_z) * hg / (1.0 + hg);\nh_op_lp = h_op_v + h_op_z;\nh_op_z = h_op_lp + h_op_v + dnrm;\nh6 = sig - h_op_lp;\n// 12 dB/oct\nh12_a1 = 1.0 / (1.0 + hg * (hg + k12));\nh12_a2 = hg * h12_a1;\nh12_a3 = hg * h12_a2;\nh12_v3 = sig - h12_ic2;\nh12_v1 = h12_ic1 * h12_a1 + h12_v3 * h12_a2;\nh12_v2 = h12_ic2 + h12_ic1 * h12_a2 + h12_v3 * h12_a3;\nh12_ic1 = 2.0 * h12_v1 - h12_ic1 + dnrm;\nh12_ic2 = 2.0 * h12_v2 - h12_ic2 + dnrm;\nh12 = sig - k12 * h12_v1 - h12_v2;\n// 18 dB/oct = one-pole -> SVF (Q 1.0)\nh18_a1 = 1.0 / (1.0 + hg * (hg + k18));\nh18_a2 = hg * h18_a1;\nh18_a3 = hg * h18_a2;\nh18_v3 = h6 - h18_ic2;\nh18_v1 = h18_ic1 * h18_a1 + h18_v3 * h18_a2;\nh18_v2 = h18_ic2 + h18_ic1 * h18_a2 + h18_v3 * h18_a3;\nh18_ic1 = 2.0 * h18_v1 - h18_ic1 + dnrm;\nh18_ic2 = 2.0 * h18_v2 - h18_ic2 + dnrm;\nh18 = h6 - k18 * h18_v1 - h18_v2;\n// 24 dB/oct = SVF (Q 0.5412) -> SVF (Q 1.3066)\nh24a_a1 = 1.0 / (1.0 + hg * (hg + k24a));\nh24a_a2 = hg * h24a_a1;\nh24a_a3 = hg * h24a_a2;\nh24a_v3 = sig - h24a_ic2;\nh24a_v1 = h24a_ic1 * h24a_a1 + h24a_v3 * h24a_a2;\nh24a_v2 = h24a_ic2 + h24a_ic1 * h24a_a2 + h24a_v3 * h24a_a3;\nh24a_ic1 = 2.0 * h24a_v1 - h24a_ic1 + dnrm;\nh24a_ic2 = 2.0 * h24a_v2 - h24a_ic2 + dnrm;\nh24a = sig - k24a * h24a_v1 - h24a_v2;\nh24b_a1 = 1.0 / (1.0 + hg * (hg + k24b));\nh24b_a2 = hg * h24b_a1;\nh24b_a3 = hg * h24b_a2;\nh24b_v3 = h24a - h24b_ic2;\nh24b_v1 = h24b_ic1 * h24b_a1 + h24b_v3 * h24b_a2;\nh24b_v2 = h24b_ic2 + h24b_ic1 * h24b_a2 + h24b_v3 * h24b_a3;\nh24b_ic1 = 2.0 * h24b_v1 - h24b_ic1 + dnrm;\nh24b_ic2 = 2.0 * h24b_v2 - h24b_ic2 + dnrm;\nh24 = h24a - k24b * h24b_v1 - h24b_v2;\n// slope crossfade (triangular weights, sum to 1)\nhw0 = max(0.0, 1.0 - abs(s_hpf_slope));\nhw1 = max(0.0, 1.0 - abs(s_hpf_slope - 1.0));\nhw2 = max(0.0, 1.0 - abs(s_hpf_slope - 2.0));\nhw3 = max(0.0, 1.0 - abs(s_hpf_slope - 3.0));\nhpf_out = h6 * hw0 + h12 * hw1 + h18 * hw2 + h24 * hw3;\n\n// === SATURATION SETUP ===\n// tanh(x*drive + bias), static offset removed, normalized to unity small-signal gain\nsat_tb = tanh(s_bias);\nsat_norm = 1.0 / (s_drive * (1.0 - sat_tb * sat_tb));\n\n// === BELL 1 ===\nb1_A = pow(10.0, s_bell1_gain / 40.0);\nb1_k = 1.0 / (s_bell1_q * b1_A);\nb1_m1 = b1_k * (b1_A * b1_A - 1.0);\nb1_g = tan(pi * min(s_bell1_freq, f_max) / srs);\nb1_a1 = 1.0 / (1.0 + b1_g * (b1_g + b1_k));\nb1_a2 = b1_g * b1_a1;\nb1_a3 = b1_g * b1_a2;\nb1_v3 = hpf_out - b1_ic2;\nb1_v1 = b1_ic1 * b1_a1 + b1_v3 * b1_a2;\nb1_v2 = b1_ic2 + b1_ic1 * b1_a2 + b1_v3 * b1_a3;\nb1_ic1 = 2.0 * b1_v1 - b1_ic1 + dnrm;\nb1_ic2 = 2.0 * b1_v2 - b1_ic2 + dnrm;\nb1_out = hpf_out + b1_m1 * b1_v1;\nsat1_out = (tanh(b1_out * s_drive + s_bias) - sat_tb) * sat_norm;\n\n// === BELL 2 ===\nb2_A = pow(10.0, s_bell2_gain / 40.0);\nb2_k = 1.0 / (s_bell2_q * b2_A);\nb2_m1 = b2_k * (b2_A * b2_A - 1.0);\nb2_g = tan(pi * min(s_bell2_freq, f_max) / srs);\nb2_a1 = 1.0 / (1.0 + b2_g * (b2_g + b2_k));\nb2_a2 = b2_g * b2_a1;\nb2_a3 = b2_g * b2_a2;\nb2_v3 = sat1_out - b2_ic2;\nb2_v1 = b2_ic1 * b2_a1 + b2_v3 * b2_a2;\nb2_v2 = b2_ic2 + b2_ic1 * b2_a2 + b2_v3 * b2_a3;\nb2_ic1 = 2.0 * b2_v1 - b2_ic1 + dnrm;\nb2_ic2 = 2.0 * b2_v2 - b2_ic2 + dnrm;\nb2_out = sat1_out + b2_m1 * b2_v1;\nsat2_out = (tanh(b2_out * s_drive + s_bias) - sat_tb) * sat_norm;\n\n// === BELL 3 ===\nb3_A = pow(10.0, s_bell3_gain / 40.0);\nb3_k = 1.0 / (s_bell3_q * b3_A);\nb3_m1 = b3_k * (b3_A * b3_A - 1.0);\nb3_g = tan(pi * min(s_bell3_freq, f_max) / srs);\nb3_a1 = 1.0 / (1.0 + b3_g * (b3_g + b3_k));\nb3_a2 = b3_g * b3_a1;\nb3_a3 = b3_g * b3_a2;\nb3_v3 = sat2_out - b3_ic2;\nb3_v1 = b3_ic1 * b3_a1 + b3_v3 * b3_a2;\nb3_v2 = b3_ic2 + b3_ic1 * b3_a2 + b3_v3 * b3_a3;\nb3_ic1 = 2.0 * b3_v1 - b3_ic1 + dnrm;\nb3_ic2 = 2.0 * b3_v2 - b3_ic2 + dnrm;\nb3_out = sat2_out + b3_m1 * b3_v1;\nsat3_out = (tanh(b3_out * s_drive + s_bias) - sat_tb) * sat_norm;\n\n// === LPF ===\nlg = tan(pi * min(s_lpf_freq, f_max) / srs);\n// 6 dB/oct one-pole\nl_op_v = (sat3_out - l_op_z) * lg / (1.0 + lg);\nl6 = l_op_v + l_op_z;\nl_op_z = l6 + l_op_v + dnrm;\n// 12 dB/oct\nl12_a1 = 1.0 / (1.0 + lg * (lg + k12));\nl12_a2 = lg * l12_a1;\nl12_a3 = lg * l12_a2;\nl12_v3 = sat3_out - l12_ic2;\nl12_v1 = l12_ic1 * l12_a1 + l12_v3 * l12_a2;\nl12 = l12_ic2 + l12_ic1 * l12_a2 + l12_v3 * l12_a3;\nl12_ic1 = 2.0 * l12_v1 - l12_ic1 + dnrm;\nl12_ic2 = 2.0 * l12 - l12_ic2 + dnrm;\n// 18 dB/oct = one-pole -> SVF (Q 1.0)\nl18_a1 = 1.0 / (1.0 + lg * (lg + k18));\nl18_a2 = lg * l18_a1;\nl18_a3 = lg * l18_a2;\nl18_v3 = l6 - l18_ic2;\nl18_v1 = l18_ic1 * l18_a1 + l18_v3 * l18_a2;\nl18 = l18_ic2 + l18_ic1 * l18_a2 + l18_v3 * l18_a3;\nl18_ic1 = 2.0 * l18_v1 - l18_ic1 + dnrm;\nl18_ic2 = 2.0 * l18 - l18_ic2 + dnrm;\n// 24 dB/oct = SVF (Q 0.5412) -> SVF (Q 1.3066)\nl24a_a1 = 1.0 / (1.0 + lg * (lg + k24a));\nl24a_a2 = lg * l24a_a1;\nl24a_a3 = lg * l24a_a2;\nl24a_v3 = sat3_out - l24a_ic2;\nl24a_v1 = l24a_ic1 * l24a_a1 + l24a_v3 * l24a_a2;\nl24a = l24a_ic2 + l24a_ic1 * l24a_a2 + l24a_v3 * l24a_a3;\nl24a_ic1 = 2.0 * l24a_v1 - l24a_ic1 + dnrm;\nl24a_ic2 = 2.0 * l24a - l24a_ic2 + dnrm;\nl24b_a1 = 1.0 / (1.0 + lg * (lg + k24b));\nl24b_a2 = lg * l24b_a1;\nl24b_a3 = lg * l24b_a2;\nl24b_v3 = l24a - l24b_ic2;\nl24b_v1 = l24b_ic1 * l24b_a1 + l24b_v3 * l24b_a2;\nl24 = l24b_ic2 + l24b_ic1 * l24b_a2 + l24b_v3 * l24b_a3;\nl24b_ic1 = 2.0 * l24b_v1 - l24b_ic1 + dnrm;\nl24b_ic2 = 2.0 * l24 - l24b_ic2 + dnrm;\n// slope crossfade\nlw0 = max(0.0, 1.0 - abs(s_lpf_slope));\nlw1 = max(0.0, 1.0 - abs(s_lpf_slope - 1.0));\nlw2 = max(0.0, 1.0 - abs(s_lpf_slope - 2.0));\nlw3 = max(0.0, 1.0 - abs(s_lpf_slope - 3.0));\nlpf_out = l6 * lw0 + l12 * lw1 + l18 * lw2 + l24 * lw3;\n\n// === OUTPUT SATURATION + DC BLOCK (~5 Hz) ===\nsat_final = (tanh(lpf_out * s_drive + s_bias) - sat_tb) * sat_norm;\ndc_r = 1.0 - 31.4159 / srs;\ndc_y = sat_final - dc_x1 + dc_r * dc_y1;\ndc_x1 = sat_final;\ndc_y1 = dc_y + dnrm;\n\nout1 = dc_y;\n",
          "numinlets": 1,
          "numoutlets": 1,
          "outlettype": [
