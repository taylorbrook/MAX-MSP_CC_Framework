                            {
                                "box": {
                                    "code": "Param depth(0.5, min=0, max=1);\nParam poles(8, min=2, max=32);\nParam feedback(0.5, min=0, max=1);\nParam tilt(0, min=-1, max=1);\nData apL(32, 1);\nData apR(32, 1);\nHistory one(1);\nHistory nsm(8);\nHistory fbL(0);\nHistory fbR(0);\nHistory tiltLP_L(0);\nHistory tiltLP_R(0);\n\n// de-hoist: nothing below is Param-only\nsrs = samplerate * one;\nk_depth = depth * one;\nk_tilt = tilt * one;\nk_fb = feedback * one;\n\n// stage count glides; output crossfades between floor(n) and floor(n)+1 stages\nns = clamp(nsm + (poles * one - nsm) * (1 - exp(-1 / (0.03 * srs))), 2, 32);\nnsm = ns;\nnlo = min(floor(ns), 31);\nnfrac = ns - nlo;\n\nbase_c = 0.3 + k_depth * 0.65;\ncL = clamp(base_c + in1 * k_depth * 0.8, -0.97, 0.97);\ncR = clamp(base_c + in2 * k_depth * 0.8, -0.97, 0.97);\nfb_amt = k_fb * 0.65;\nxL = in1 + tanh(fbL * fb_amt);\nxR = in2 + tanh(fbR * fb_amt);\n\n// all 32 stages always run so every stage state stays warm\nsL = 0;\nsR = 0;\nyL = 0;\nyR = 0;\nloL = 0;\nloR = 0;\nhiL = 0;\nhiR = 0;\nfor (i = 0; i < 32; i += 1) {\n    sL = peek(apL, i, 0);\n    yL = sL + cL * xL;\n    poke(apL, xL - cL * yL, i, 0);\n    xL = yL;\n    sR = peek(apR, i, 0);\n    yR = sR + cR * xR;\n    poke(apR, xR - cR * yR, i, 0);\n    xR = yR;\n    if (i > nlo - 1.5) {\n        if (i < nlo - 0.5) {\n            loL = xL;\n            loR = xR;\n        }\n    }\n    if (i > nlo - 0.5) {\n        if (i < nlo + 0.5) {\n            hiL = xL;\n            hiR = xR;\n        }\n    }\n}\noutL = loL + (hiL - loL) * nfrac;\noutR = loR + (hiR - loR) * nfrac;\n\nfbL = outL;\nfbR = outR;\n\ntc = exp(-twopi * 800 / srs);\nlpL = tiltLP_L * tc + outL * (1 - tc);\nlpR = tiltLP_R * tc + outR * (1 - tc);\ntiltLP_L = lpL;\ntiltLP_R = lpR;\nhpL = outL - lpL;\nhpR = outR - lpR;\nlowG = pow(10, -0.6 * k_tilt);\nhighG = pow(10, 0.6 * k_tilt);\noutL = lpL * lowG + hpL * highG;\noutR = lpR * lowG + hpR * highG;\n\noutL = in1 * (1 - k_depth) + outL * k_depth;\noutR = in2 * (1 - k_depth) + outR * k_depth;\nout1 = outL;\nout2 = outR;\n",
