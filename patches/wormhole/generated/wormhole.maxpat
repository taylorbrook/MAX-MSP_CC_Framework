                                    "code": "Param pitch(0, min=-48, max=48);\nParam freq_shift(0, min=-4000, max=4000);\nParam pitch_mode(0, min=0, max=3);\nParam decay_time(1, min=0.01, max=1);\nDelay pitchBufL(4096);\nDelay pitchBufR(4096);\nHistory one(1);\nHistory phL1(0);\nHistory phL2(0.5);\nHistory phR1(0);\nHistory phR2(0.5);\nHistory ps_on(0);\nHistory fs_on(0);\nHistory carrier_phase(0);\nHistory hA1Lx1(0);\nHistory hA1Lx2(0);\nHistory hA1Ly1(0);\nHistory hA1Ly2(0);\nHistory hA2Lx1(0);\nHistory hA2Lx2(0);\nHistory hA2Ly1(0);\nHistory hA2Ly2(0);\nHistory hA3Lx1(0);\nHistory hA3Lx2(0);\nHistory hA3Ly1(0);\nHistory hA3Ly2(0);\nHistory hA4Lx1(0);\nHistory hA4Lx2(0);\nHistory hA4Ly1(0);\nHistory hA4Ly2(0);\nHistory dAL(0);\nHistory hB1Lx1(0);\nHistory hB1Lx2(0);\nHistory hB1Ly1(0);\nHistory hB1Ly2(0);\nHistory hB2Lx1(0);\nHistory hB2Lx2(0);\nHistory hB2Ly1(0);\nHistory hB2Ly2(0);\nHistory hB3Lx1(0);\nHistory hB3Lx2(0);\nHistory hB3Ly1(0);\nHistory hB3Ly2(0);\nHistory hB4Lx1(0);\nHistory hB4Lx2(0);\nHistory hB4Ly1(0);\nHistory hB4Ly2(0);\nHistory hA1Rx1(0);\nHistory hA1Rx2(0);\nHistory hA1Ry1(0);\nHistory hA1Ry2(0);\nHistory hA2Rx1(0);\nHistory hA2Rx2(0);\nHistory hA2Ry1(0);\nHistory hA2Ry2(0);\nHistory hA3Rx1(0);\nHistory hA3Rx2(0);\nHistory hA3Ry1(0);\nHistory hA3Ry2(0);\nHistory hA4Rx1(0);\nHistory hA4Rx2(0);\nHistory hA4Ry1(0);\nHistory hA4Ry2(0);\nHistory dAR(0);\nHistory hB1Rx1(0);\nHistory hB1Rx2(0);\nHistory hB1Ry1(0);\nHistory hB1Ry2(0);\nHistory hB2Rx1(0);\nHistory hB2Rx2(0);\nHistory hB2Ry1(0);\nHistory hB2Ry2(0);\nHistory hB3Rx1(0);\nHistory hB3Rx2(0);\nHistory hB3Ry1(0);\nHistory hB3Ry2(0);\nHistory hB4Rx1(0);\nHistory hB4Rx2(0);\nHistory hB4Ry1(0);\nHistory hB4Ry2(0);\nHistory envInL(0);\nHistory envInR(0);\nHistory envOutL(0);\nHistory envOutR(0);\nHistory gL(1);\nHistory gR(1);\n\n// de-hoist: nothing below is Param-only\nsrs = samplerate * one;\nk_pitch = pitch * one;\nk_fs = freq_shift * one;\nk_mode = pitch_mode * one;\nk_decay = decay_time * one;\nslew20 = 1 - exp(-1 / (0.02 * srs));\n\npitchBufL.write(in1);\npitchBufR.write(in2);\n\n// ---- pitch shift: two crossfading delay taps ----\nwin = 2048;\nif (k_mode > 0.5) {\n    if (k_mode < 1.5) {\n        win = 512;\n    }\n}\nif (k_mode > 2.5) {\n    win = 512;\n}\ndetune = 0;\nif (k_mode > 1.5) {\n    detune = 0.48;\n}\npL = k_pitch + detune;\npR = k_pitch - detune;\n// signed rate: delay grows for down-shift, shrinks for up-shift\nrateL = 1 - pow(2, pL / 12);\nrateR = 1 - pow(2, pR / 12);\n\nnL1 = wrap(phL1 + rateL / win);\nnL2 = wrap(phL2 + rateL / win);\nnR1 = wrap(phR1 + rateR / win);\nnR2 = wrap(phR2 + rateR / win);\nphL1 = nL1;\nphL2 = nL2;\nphR1 = nR1;\nphR2 = nR2;\n\nwL1 = sin(nL1 * pi) * sin(nL1 * pi);\nwL2 = sin(nL2 * pi) * sin(nL2 * pi);\nwR1 = sin(nR1 * pi) * sin(nR1 * pi);\nwR2 = sin(nR2 * pi) * sin(nR2 * pi);\n\nshL = pitchBufL.read(nL1 * win) * wL1 + pitchBufL.read(nL2 * win) * wL2;\nshR = pitchBufR.read(nR1 * win) * wR1 + pitchBufR.read(nR2 * win) * wR2;\n\n// no shift and no detune: crossfade to the clean input\nps_t = (abs(k_pitch) + detune) > 0.001;\nps_n = ps_on + (ps_t - ps_on) * slew20;\nps_on = ps_n;\npsL = in1 + (shL - in1) * ps_n;\npsR = in2 + (shR - in2) * ps_n;\n\n// ---- frequency shift: Hilbert SSB (Niemitalo 4+4 allpass pair) ----\n// Hilbert path A L: four 2nd-order allpasses\nhA1L = 0.4794008655888 * (psL + hA1Ly2) - hA1Lx2; hA1Lx2 = hA1Lx1; hA1Lx1 = psL; hA1Ly2 = hA1Ly1; hA1Ly1 = hA1L;\nhA2L = 0.8762184935393 * (hA1L + hA2Ly2) - hA2Lx2; hA2Lx2 = hA2Lx1; hA2Lx1 = hA1L; hA2Ly2 = hA2Ly1; hA2Ly1 = hA2L;\nhA3L = 0.9765975895082 * (hA2L + hA3Ly2) - hA3Lx2; hA3Lx2 = hA3Lx1; hA3Lx1 = hA2L; hA3Ly2 = hA3Ly1; hA3Ly1 = hA3L;\nhA4L = 0.9974992559355 * (hA3L + hA4Ly2) - hA4Lx2; hA4Lx2 = hA4Lx1; hA4Lx1 = hA3L; hA4Ly2 = hA4Ly1; hA4Ly1 = hA4L;\nIL = dAL; dAL = hA4L;\n\n// Hilbert path B L: four 2nd-order allpasses\nhB1L = 0.1617584983677 * (psL + hB1Ly2) - hB1Lx2; hB1Lx2 = hB1Lx1; hB1Lx1 = psL; hB1Ly2 = hB1Ly1; hB1Ly1 = hB1L;\nhB2L = 0.7330289323415 * (hB1L + hB2Ly2) - hB2Lx2; hB2Lx2 = hB2Lx1; hB2Lx1 = hB1L; hB2Ly2 = hB2Ly1; hB2Ly1 = hB2L;\nhB3L = 0.9453497003291 * (hB2L + hB3Ly2) - hB3Lx2; hB3Lx2 = hB3Lx1; hB3Lx1 = hB2L; hB3Ly2 = hB3Ly1; hB3Ly1 = hB3L;\nhB4L = 0.9905991566845 * (hB3L + hB4Ly2) - hB4Lx2; hB4Lx2 = hB4Lx1; hB4Lx1 = hB3L; hB4Ly2 = hB4Ly1; hB4Ly1 = hB4L;\nQL = hB4L;\n\n// Hilbert path A R: four 2nd-order allpasses\nhA1R = 0.4794008655888 * (psR + hA1Ry2) - hA1Rx2; hA1Rx2 = hA1Rx1; hA1Rx1 = psR; hA1Ry2 = hA1Ry1; hA1Ry1 = hA1R;\nhA2R = 0.8762184935393 * (hA1R + hA2Ry2) - hA2Rx2; hA2Rx2 = hA2Rx1; hA2Rx1 = hA1R; hA2Ry2 = hA2Ry1; hA2Ry1 = hA2R;\nhA3R = 0.9765975895082 * (hA2R + hA3Ry2) - hA3Rx2; hA3Rx2 = hA3Rx1; hA3Rx1 = hA2R; hA3Ry2 = hA3Ry1; hA3Ry1 = hA3R;\nhA4R = 0.9974992559355 * (hA3R + hA4Ry2) - hA4Rx2; hA4Rx2 = hA4Rx1; hA4Rx1 = hA3R; hA4Ry2 = hA4Ry1; hA4Ry1 = hA4R;\nIR = dAR; dAR = hA4R;\n\n// Hilbert path B R: four 2nd-order allpasses\nhB1R = 0.1617584983677 * (psR + hB1Ry2) - hB1Rx2; hB1Rx2 = hB1Rx1; hB1Rx1 = psR; hB1Ry2 = hB1Ry1; hB1Ry1 = hB1R;\nhB2R = 0.7330289323415 * (hB1R + hB2Ry2) - hB2Rx2; hB2Rx2 = hB2Rx1; hB2Rx1 = hB1R; hB2Ry2 = hB2Ry1; hB2Ry1 = hB2R;\nhB3R = 0.9453497003291 * (hB2R + hB3Ry2) - hB3Rx2; hB3Rx2 = hB3Rx1; hB3Rx1 = hB2R; hB3Ry2 = hB3Ry1; hB3Ry1 = hB3R;\nhB4R = 0.9905991566845 * (hB3R + hB4Ry2) - hB4Rx2; hB4Rx2 = hB4Rx1; hB4Rx1 = hB3R; hB4Ry2 = hB4Ry1; hB4Ry1 = hB4R;\nQR = hB4R;\n\ncp = wrap(carrier_phase + k_fs / srs);\ncarrier_phase = cp;\ncos_c = cos(cp * twopi);\nsin_c = sin(cp * twopi);\nfsL = IL * cos_c + QL * sin_c;\nfsR = IR * cos_c + QR * sin_c;\n\nfs_t = abs(k_fs) > 0.001;\nfs_n = fs_on + (fs_t - fs_on) * slew20;\nfs_on = fs_n;\nsigL = psL + (fsL - psL) * fs_n;\nsigR = psR + (fsR - psR) * fs_n;\n\n// ---- decay: output envelope may not outlast the input envelope ----\n// input env releases over decay_time * 2 s to -60 dB; level independent\nrelIn = exp(-6.9 / (k_decay * 2 * srs));\nrelOut = exp(-1 / (0.02 * srs));\neInL = max(abs(in1), envInL * relIn);\neInR = max(abs(in2), envInR * relIn);\neOutL = max(abs(sigL), envOutL * relOut);\neOutR = max(abs(sigR), envOutR * relOut);\nenvInL = eInL;\nenvInR = eInR;\nenvOutL = eOutL;\nenvOutR = eOutR;\ngtL = min(1, eInL / max(eOutL, 0.000001));\ngtR = min(1, eInR / max(eOutR, 0.000001));\nslew5 = 1 - exp(-1 / (0.005 * srs));\ngnL = gL + (gtL - gL) * slew5;\ngnR = gR + (gtR - gR) * slew5;\ngL = gnL;\ngR = gnR;\n\nout1 = sigL * gnL;\nout2 = sigR * gnR;\n",
                                    "fontface": 0,
