                            {
                                "box": {
                                    "code": "Param pitch(0, min=-48, max=48);\nParam freq_shift(0, min=-4000, max=4000);\nParam pitch_mode(0, min=0, max=3);\nParam decay_time(1, min=0.01, max=1);\nDelay pitchBufL(4096);\nDelay pitchBufR(4096);\nHistory phL1(0);\nHistory phL2(0.5);\nHistory phR1(0);\nHistory phR2(0.5);\nHistory carrier_phase(0);\nHistory xA1L(0);\nHistory yA1L(0);\nHistory xA2L(0);\nHistory yA2L(0);\nHistory xB1L(0);\nHistory yB1L(0);\nHistory xB2L(0);\nHistory yB2L(0);\nHistory xA1R(0);\nHistory yA1R(0);\nHistory xA2R(0);\nHistory yA2R(0);\nHistory xB1R(0);\nHistory yB1R(0);\nHistory xB2R(0);\nHistory yB2R(0);\nHistory envL(0);\nHistory envR(0);\n\npitchBufL.write(in1);\npitchBufR.write(in2);\n\nwin = 2048;\nif (pitch_mode > 0.5) {\n    if (pitch_mode < 1.5) {\n        win = 512;\n    }\n}\n\ndetune = 0;\nif (pitch_mode > 1.5) {\n    detune = 0.48;\n}\npL = pitch + detune;\npR = pitch - detune;\nrateL = 1 - pow(2, pL / 12);\nrateR = 1 - pow(2, pR / 12);\n\nphL1 = wrap(phL1 + abs(rateL) / win);\nphL2 = wrap(phL2 + abs(rateL) / win);\nphR1 = wrap(phR1 + abs(rateR) / win);\nphR2 = wrap(phR2 + abs(rateR) / win);\n\ndL1 = phL1 * win;\ndL2 = phL2 * win;\ndR1 = phR1 * win;\ndR2 = phR2 * win;\n\nwL1 = sin(phL1 * pi) * sin(phL1 * pi);\nwL2 = sin(phL2 * pi) * sin(phL2 * pi);\nwR1 = sin(phR1 * pi) * sin(phR1 * pi);\nwR2 = sin(phR2 * pi) * sin(phR2 * pi);\n\ntL1 = pitchBufL.read(dL1);\ntL2 = pitchBufL.read(dL2);\ntR1 = pitchBufR.read(dR1);\ntR2 = pitchBufR.read(dR2);\n\npsL = tL1 * wL1 + tL2 * wL2;\npsR = tR1 * wR1 + tR2 * wR2;\n\ncarrier_phase = wrap(carrier_phase + freq_shift / samplerate);\ncos_c = cos(carrier_phase * twopi);\nsin_c = sin(carrier_phase * twopi);\n\na1 = 0.6923878;\na2 = 0.9360654322959;\nb1 = 0.4021921162426;\nb2 = 0.8561710882420;\n\ntmpA = a1 * (psL - yA1L) + xA1L; xA1L = psL; yA1L = tmpA;\nhilA_L = a2 * (tmpA - yA2L) + xA2L; xA2L = tmpA; yA2L = hilA_L;\ntmpB = b1 * (psL - yB1L) + xB1L; xB1L = psL; yB1L = tmpB;\nhilB_L = b2 * (tmpB - yB2L) + xB2L; xB2L = tmpB; yB2L = hilB_L;\n\ntmpA = a1 * (psR - yA1R) + xA1R; xA1R = psR; yA1R = tmpA;\nhilA_R = a2 * (tmpA - yA2R) + xA2R; xA2R = tmpA; yA2R = hilA_R;\ntmpB = b1 * (psR - yB1R) + xB1R; xB1R = psR; yB1R = tmpB;\nhilB_R = b2 * (tmpB - yB2R) + xB2R; xB2R = tmpB; yB2R = hilB_R;\n\nfsL = hilA_L * cos_c - hilB_L * sin_c;\nfsR = hilA_R * cos_c - hilB_R * sin_c;\n\nfs_active = smoothstep(0, 100, abs(freq_shift));\nsigL = psL * (1 - fs_active) + fsL * fs_active;\nsigR = psR * (1 - fs_active) + fsR * fs_active;\n\nrel_samples = decay_time * samplerate * 0.5 + 100;\nrel_coeff = exp(-6.9 / rel_samples);\nenvL = max(abs(in1), envL * rel_coeff);\nenvR = max(abs(in2), envR * rel_coeff);\noutL = sigL * clamp(envL * 4, 0, 1);\noutR = sigR * clamp(envR * 4, 0, 1);\n\nout1 = outL;\nout2 = outR;\n",
                                    "fontface": 0,
