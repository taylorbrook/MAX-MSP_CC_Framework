                            {
                                "box": {
                                    "code": "Param rev_mix(0.3, min=0, max=1);\nParam size(0.7, min=0.1, max=1);\nParam damping(0.5, min=0, max=1);\nDelay dl1(20000);\nDelay dl2(20000);\nDelay dl3(20000);\nDelay dl4(20000);\nHistory fb1(0);\nHistory fb2(0);\nHistory fb3(0);\nHistory fb4(0);\nHistory lp1(0);\nHistory lp2(0);\nHistory lp3(0);\nHistory lp4(0);\nHistory mod_ph1(0);\nHistory mod_ph2(0.25);\nHistory mod_ph3(0.5);\nHistory mod_ph4(0.75);\nHistory one(1);\nHistory sz(0.7);\n\nsrs = samplerate * one;\nszn = sz + (size * one - sz) * (1 - exp(-1 / (0.1 * srs)));\nsz = szn;\nsr_k = srs / 48000;\n\nd1_time = (2903 * szn + 150) * sr_k;\nd2_time = (3793 * szn + 150) * sr_k;\nd3_time = (3119 * szn + 150) * sr_k;\nd4_time = (4271 * szn + 150) * sr_k;\n\nmod_rate = 0.37 / srs;\nmod_ph1 = wrap(mod_ph1 + mod_rate);\nmod_ph2 = wrap(mod_ph2 + mod_rate * 1.19);\nmod_ph3 = wrap(mod_ph3 + mod_rate * 0.83);\nmod_ph4 = wrap(mod_ph4 + mod_rate * 1.31);\nm1 = sin(mod_ph1 * twopi) * 43 * sr_k;\nm2 = sin(mod_ph2 * twopi) * 61 * sr_k;\nm3 = sin(mod_ph3 * twopi) * 37 * sr_k;\nm4 = sin(mod_ph4 * twopi) * 53 * sr_k;\n\ndl1.write(in1 + fb1);\ndl2.write(in2 + fb2);\ndl3.write((in1 + in2) * 0.5 + fb3);\ndl4.write((in1 - in2) * 0.5 + fb4);\n\nt1 = dl1.read(d1_time + m1);\nt2 = dl2.read(d2_time + m2);\nt3 = dl3.read(d3_time + m3);\nt4 = dl4.read(d4_time + m4);\n\nk_damp = damping * one;\ndamp_fc = min(20000 * pow(0.0625, k_damp * k_damp), srs * 0.45);\ndamp_c = 1 - exp(-twopi * damp_fc / srs);\nlp1 = lp1 + damp_c * (t1 - lp1);\nlp2 = lp2 + damp_c * (t2 - lp2);\nlp3 = lp3 + damp_c * (t3 - lp3);\nlp4 = lp4 + damp_c * (t4 - lp4);\n\nfb_gain = 0.55 + szn * 0.3;\nfb1 = (lp1 + lp2 + lp3 + lp4) * 0.5 * fb_gain;\nfb2 = (lp1 - lp2 + lp3 - lp4) * 0.5 * fb_gain;\nfb3 = (lp1 + lp2 - lp3 - lp4) * 0.5 * fb_gain;\nfb4 = (lp1 - lp2 - lp3 + lp4) * 0.5 * fb_gain;\n\nwetL = (t1 + t3) * 0.7;\nwetR = (t2 + t4) * 0.7;\nout1 = in1 * (1 - rev_mix) + wetL * rev_mix;\nout2 = in2 * (1 - rev_mix) + wetR * rev_mix;\n",
