                            {
                                "box": {
                                    "code": "Param blend(0.5, min=0, max=1);\nParam morph_mode(0, min=0, max=1);\nHistory envL(0);\nHistory envR(0);\n\ndryL = in1;\ndryR = in2;\nwetL = in3;\nwetR = in4;\n\nenv_coeff = 0.995;\nenvL = max(abs(dryL) * 2, envL * env_coeff);\nenvR = max(abs(dryR) * 2, envR * env_coeff);\n\noutL = 0;\noutR = 0;\nif (morph_mode < 0.5) {\n    outL = dryL * (1 - blend) + wetL * blend;\n    outR = dryR * (1 - blend) + wetR * blend;\n} else {\n    morphL = wetL * clamp(envL, 0, 1);\n    morphR = wetR * clamp(envR, 0, 1);\n    outL = dryL * (1 - blend) + morphL * blend;\n    outR = dryR * (1 - blend) + morphR * blend;\n}\n\nout1 = outL;\nout2 = outR;\n",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
