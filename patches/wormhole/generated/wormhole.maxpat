                            {
                                "box": {
                                    "code": "Param rev_mix(0.3, min=0, max=1);\nParam size(0.7, min=0.1, max=1);\nParam damping(0.5, min=0, max=1);\nDelay dl1(8192);\nDelay dl2(8192);\nDelay dl3(8192);\nDelay dl4(8192);\nHistory fb1(0);\nHistory fb2(0);\nHistory fb3(0);\nHistory fb4(0);\nHistory lp1(0);\nHistory lp2(0);\nHistory lp3(0);\nHistory lp4(0);\nHistory mod_ph1(0);\nHistory mod_ph2(0.25);\nHistory mod_ph3(0.5);\nHistory mod_ph4(0.75);\n\nd1_time = 3407 * size + 150;\nd2_time = 3571 * size + 150;\nd3_time = 3259 * size + 150;\nd4_time = 4001 * size + 150;\n\nmod_rate = 0.5 / samplerate;\nmod_ph1 = wrap(mod_ph1 + mod_rate);\nmod_ph2 = wrap(mod_ph2 + mod_rate * 1.13);\nmod_ph3 = wrap(mod_ph3 + mod_rate * 0.89);\nmod_ph4 = wrap(mod_ph4 + mod_rate * 1.23);\nm1 = sin(mod_ph1 * twopi) * 47;\nm2 = sin(mod_ph2 * twopi) * 53;\nm3 = sin(mod_ph3 * twopi) * 41;\nm4 = sin(mod_ph4 * twopi) * 59;\n\ndl1.write(in1 + fb1);\ndl2.write(in2 + fb2);\ndl3.write((in1 + in2) * 0.5 + fb3);\ndl4.write((in1 - in2) * 0.5 + fb4);\n\nt1 = dl1.read(d1_time + m1);\nt2 = dl2.read(d2_time + m2);\nt3 = dl3.read(d3_time + m3);\nt4 = dl4.read(d4_time + m4);\n\ndamp_c = 1 - damping * 0.5;\nlp1 = lp1 + damp_c * (t1 - lp1);\nlp2 = lp2 + damp_c * (t2 - lp2);\nlp3 = lp3 + damp_c * (t3 - lp3);\nlp4 = lp4 + damp_c * (t4 - lp4);\n\nfb_gain = 0.55 + size * 0.3;\nfb1 = (lp1 + lp2 + lp3 + lp4) * 0.5 * fb_gain;\nfb2 = (lp1 - lp2 + lp3 - lp4) * 0.5 * fb_gain;\nfb3 = (lp1 + lp2 - lp3 - lp4) * 0.5 * fb_gain;\nfb4 = (lp1 - lp2 - lp3 + lp4) * 0.5 * fb_gain;\n\nwetL = (t1 + t3) * 0.7;\nwetR = (t2 + t4) * 0.7;\nout1 = in1 * (1 - rev_mix) + wetL * rev_mix;\nout2 = in2 * (1 - rev_mix) + wetR * rev_mix;\n",
