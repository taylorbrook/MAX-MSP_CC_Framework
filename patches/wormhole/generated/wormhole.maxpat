                            {
                                "box": {
                                    "code": "Param depth(0.5, min=0, max=1);\nParam poles(0.5, min=0, max=1);\nParam tilt(0, min=-1, max=1);\nHistory apL1(0);\nHistory apL2(0);\nHistory apL3(0);\nHistory apL4(0);\nHistory apL5(0);\nHistory apL6(0);\nHistory apL7(0);\nHistory apL8(0);\nHistory apR1(0);\nHistory apR2(0);\nHistory apR3(0);\nHistory apR4(0);\nHistory apR5(0);\nHistory apR6(0);\nHistory apR7(0);\nHistory apR8(0);\nHistory fbL(0);\nHistory fbR(0);\nHistory tiltLP_L(0);\nHistory tiltLP_R(0);\n\nbase_c = 0.3 + depth * 0.65;\nmodL = in1 * depth * 0.8;\nmodR = in2 * depth * 0.8;\nfb_amt = poles * 0.65;\nxL = in1 + tanh(fbL * fb_amt);\nxR = in2 + tanh(fbR * fb_amt);\ncL = clamp(base_c + modL, -0.97, 0.97);\ncR = clamp(base_c + modR, -0.97, 0.97);\n\nyL = apL1 + cL * xL; apL1 = xL - cL * yL; xL = yL;\nyL = apL2 + cL * xL; apL2 = xL - cL * yL; xL = yL;\nyL = apL3 + cL * xL; apL3 = xL - cL * yL; xL = yL;\nyL = apL4 + cL * xL; apL4 = xL - cL * yL; xL = yL;\nyL = apL5 + cL * xL; apL5 = xL - cL * yL; xL = yL;\nyL = apL6 + cL * xL; apL6 = xL - cL * yL; xL = yL;\nyL = apL7 + cL * xL; apL7 = xL - cL * yL; xL = yL;\nyL = apL8 + cL * xL; apL8 = xL - cL * yL; xL = yL;\noutL = xL;\n\nyR = apR1 + cR * xR; apR1 = xR - cR * yR; xR = yR;\nyR = apR2 + cR * xR; apR2 = xR - cR * yR; xR = yR;\nyR = apR3 + cR * xR; apR3 = xR - cR * yR; xR = yR;\nyR = apR4 + cR * xR; apR4 = xR - cR * yR; xR = yR;\nyR = apR5 + cR * xR; apR5 = xR - cR * yR; xR = yR;\nyR = apR6 + cR * xR; apR6 = xR - cR * yR; xR = yR;\nyR = apR7 + cR * xR; apR7 = xR - cR * yR; xR = yR;\nyR = apR8 + cR * xR; apR8 = xR - cR * yR; xR = yR;\noutR = xR;\n\nfbL = outL;\nfbR = outR;\n\ntc = 0.995 - abs(tilt) * 0.8;\ntiltLP_L = tiltLP_L * tc + outL * (1 - tc);\ntiltLP_R = tiltLP_R * tc + outR * (1 - tc);\nhpL = outL - tiltLP_L;\nhpR = outR - tiltLP_R;\nt_mix = tilt * 0.5 + 0.5;\noutL = tiltLP_L * (1 - t_mix) + hpL * t_mix;\noutR = tiltLP_R * (1 - t_mix) + hpR * t_mix;\n\noutL = in1 * (1 - depth) + outL * depth;\noutR = in2 * (1 - depth) + outR * depth;\nout1 = outL;\nout2 = outR;\n",
