                                    "patching_rect": [
                                        20,
                                        382,
                                        700,
                                        22
                                    ],
                                    "text": "Each note is added to bach.roll with addchord (onset, midicents, 500 ms, velocity); the view scrolls in a 20 s window.",
                                    "fontname": "Arial",
                                    "fontsize": 12.0
                                }
                            },
                            {
                                "box": {
                                    "maxclass": "comment",
                                    "id": "obj-17",
                                    "numinlets": 1,
