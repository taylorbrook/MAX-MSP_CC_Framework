      {
        "box": {
          "maxclass": "codebox",
          "id": "obj-2",
          "code": "// Gong Physical Model Engine v0.7 — DIAGNOSTIC BUILD\n// Stripped to bare resonator bank to isolate decay issue\n\n// =====================================================\n// DECLARATIONS\n// =====================================================\nParam base_freq(220, min=20, max=2000);\nParam structure(0.5, min=0, max=1);\nParam brightness(0.5, min=0, max=1);\nParam decay_time(8, min=0.1, max=30);\nParam position(0.5, min=0, max=1);\nParam nonlinearity(0.1, min=0, max=1);\nParam num_modes(16, min=4, max=32);\nParam mallet_hardness(0.5, min=0, max=1);\nParam bloom_amount(0.1, min=0, max=1);\nParam bloom_speed(1, min=0.1, max=5);\nParam velocity(0, min=0, max=1);\nParam aftertouch(0, min=0, max=1);\nParam strike_count(0, min=0, max=10000);\nParam strike_force(0.8, min=0, max=1);\nParam output_gain(0.5, min=0, max=1);\n\n// State for 16 resonators (reduced from 32 for simplicity)\nData mode_y1(16);\nData mode_y2(16);\nData mode_a1(16);\nData mode_a2(16);\nData init_flag(1);\n\nHistory s_freq(220);\nHistory s_bright(0.5);\nHistory s_decay(8);\nHistory s_gain(0.5);\nHistory prev_vel(0);\nHistory prev_sc(0);\nHistory burst_env(0);\nHistory burst_vel(0);\nHistory burst_lp(0);\nHistory dcx0(0);\nHistory dcy0(0);\nHistory dcx1(0);\nHistory dcy1(0);\n\n// =====================================================\n// INIT — compute resonator coefficients once\n// =====================================================\nif (peek(init_flag, 0, 0) < 0.5) {\n    // Inharmonic ratios for a metallic bar/plate\n    // Using simple formula: ratio_n = (n+1)^1.5 / 1^1.5 (approximate circular plate modes)\n    for (i = 0; i < 16; i += 1) {\n        poke(mode_y1, 0, i, 0);\n        poke(mode_y2, 0, i, 0);\n\n        ratio = pow(i + 1, 1.4);\n        freq = 220 * ratio;\n        freq = min(freq, samplerate * 0.49);\n\n        t60 = 8.0 * pow(ratio, -0.5);\n        t60 = max(t60, 0.2);\n\n        r = exp(-6.9078 / (t60 * samplerate));\n        theta = TWOPI * freq / samplerate;\n\n        poke(mode_a1, 2.0 * r * cos(theta), i, 0);\n        poke(mode_a2, -(r * r), i, 0);\n    }\n    poke(init_flag, 1, 0, 0);\n}\n\n\n// =====================================================\n// PARAMETER SMOOTHING\n// =====================================================\nsm = 0.001;\ns_freq = s_freq + (base_freq - s_freq) * sm;\ns_bright = s_bright + (brightness - s_bright) * sm;\ns_decay = s_decay + (decay_time - s_decay) * sm;\ns_gain = s_gain + (output_gain - s_gain) * sm;\n\n\n// =====================================================\n// COEFFICIENT UPDATE — recompute ALL modes every sample\n// (no round-robin — just brute force to eliminate that as a variable)\n// =====================================================\ndamp_slope = 0.7 - s_bright * 0.4;\nfor (m = 0; m < 16; m += 1) {\n    ratio = pow(m + 1, 1.4);\n    freq = s_freq * ratio;\n    freq = min(freq, samplerate * 0.49);\n\n    t60 = s_decay * pow(ratio, -damp_slope);\n    t60 = max(t60, 0.2);\n\n    r = exp(-6.9078 / (t60 * samplerate));\n    theta = TWOPI * freq / samplerate;\n\n    poke(mode_a1, 2.0 * r * cos(theta), m, 0);\n    poke(mode_a2, -(r * r), m, 0);\n}\n\n\n// =====================================================\n// TRIGGER DETECTION\n// =====================================================\nvel = velocity;\nsc = strike_count;\nmidi_onset = (vel > 0.01 && prev_vel < 0.01) ? 1 : 0;\ncount_onset = (sc != prev_sc) ? 1 : 0;\nonset = (midi_onset > 0.5 || count_onset > 0.5) ? 1 : 0;\nif (count_onset > 0.5 && midi_onset < 0.5) {\n    vel = strike_force;\n}\nprev_vel = velocity;\nprev_sc = sc;\n\nif (onset > 0.5) {\n    // Damp existing resonance\n    for (md = 0; md < 16; md += 1) {\n        poke(mode_y1, peek(mode_y1, md, 0) * 0.1, md, 0);\n        poke(mode_y2, peek(mode_y2, md, 0) * 0.1, md, 0);\n    }\n    burst_vel = vel;\n    burst_env = 1.0;\n}\n\n\n// =====================================================\n// EXCITATION — noise burst\n// =====================================================\nhard = clamp(mallet_hardness, 0, 1);\ndecay_samps = (1.0 + (1.0 - hard) * 4.0) * 0.001 * samplerate;\ndecay_coeff = exp(-1.0 / max(decay_samps, 1));\n\nraw_burst = noise() * burst_env * burst_vel;\nburst_env = burst_env * decay_coeff;\n\ncutoff = 500 + hard * 7500;\nlp_coeff = 1.0 - exp(-TWOPI * cutoff / samplerate);\nburst_lp = burst_lp + lp_coeff * (raw_burst - burst_lp);\n\nexcitation = burst_lp + in1;\n\n\n// =====================================================\n// RESONATOR BANK — 16 parallel biquad resonators\n// =====================================================\nsum_L = 0;\nsum_R = 0;\n\nfor (m = 0; m < 16; m += 1) {\n    a1 = peek(mode_a1, m, 0);\n    a2 = peek(mode_a2, m, 0);\n    y1 = peek(mode_y1, m, 0);\n    y2 = peek(mode_y2, m, 0);\n\n    // All modes get excitation (no position gating for now)\n    y = a1 * y1 + a2 * y2 + excitation;\n\n    poke(mode_y1, y, m, 0);\n    poke(mode_y2, y1, m, 0);\n\n    // Stereo: even L, odd R\n    is_even = 1.0 - (m % 2);\n    sum_L += y * is_even;\n    sum_R += y * (1.0 - is_even);\n}\n\n\n// =====================================================\n// OUTPUT\n// =====================================================\nscale = s_gain / max(sqrt(16), 1.0);\nwet_L = sum_L * scale;\nwet_R = sum_R * scale;\n\n// DC blocker\nw0 = wet_L - dcx0 + 0.995 * dcy0;\ndcx0 = wet_L;\ndcy0 = w0;\nw1 = wet_R - dcx1 + 0.995 * dcy1;\ndcx1 = wet_R;\ndcy1 = w1;\n\nout1 = tanh(w0);\nout2 = tanh(w1);\n",
          "numinlets": 1,
          "numoutlets": 2,
          "outlettype": [
