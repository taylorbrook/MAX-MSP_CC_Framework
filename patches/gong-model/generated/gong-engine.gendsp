          "fontsize": 12.0
        }
      },
      {
        "box": {
          "maxclass": "codebox",
          "id": "obj-2",
          "code": "// Gong Physical Model Engine v1.9.0\n// Modal synthesis: 32 resonators, 5-point structure morph,\n// per-structure decay profiles, nonlinear coupling, bloom, pitch glide\n\n// =====================================================\n// DECLARATIONS (all must precede expressions)\n// =====================================================\n\nParam base_freq(110, min=20, max=2000);\nParam structure(0.5, min=0, max=1);\nParam brightness(0.5, min=0, max=1);\nParam decay_time(8, min=0.1, max=30);\nParam position(0.5, min=0, max=1);\nParam excitation_angle(0.5, min=0, max=1);\nParam nonlinearity(0.1, min=0, max=1);\nParam num_modes(16, min=4, max=32);\nParam mallet_hardness(0.5, min=0, max=1);\nParam bloom_amount(0.1, min=0, max=1);\nParam bloom_speed(1, min=0.1, max=5);\nParam bloom_persist(0, min=0, max=1);\nParam velocity(0, min=0, max=1);\nParam aftertouch(0, min=0, max=1);\nParam strike_count(0, min=0, max=10000);\nParam strike_force(0.8, min=0, max=1);\nParam output_gain(0.5, min=0, max=1);\nParam noise_level(0.5, min=0, max=1);\nParam material(0.3, min=0, max=1);\nParam stereo_width(1, min=0, max=1);\nParam vel_curve(1, min=0.3, max=3.0);\nParam detune(0, min=0, max=1);\n\nData mode_y1(32);\nData mode_y2(32);\nData mode_a1(32);\nData mode_a2(32);\nData mode_freq(32);\nData mode_output(32);\nData mode_env(32);\nData mode_detune(32);\nData ratio_table(32, 5);\nData coupling_map(16, 4);\nData bloom_map(64, 4);\nData current_ratios(32);\nData decay_table(32, 5);\nData current_decays(32);\nData pos_gain(32);\nData init_flag(1);\nData mat_params(5, 7);\n\nBuffer mode_gains;\n\nHistory s_freq(110);\nHistory s_struct(0.5);\nHistory s_bright(0.5);\nHistory s_decay(4);\nHistory s_pos(0.5);\nHistory s_angle(0.5);\nHistory s_nonlin(0.1);\nHistory s_hard(0.5);\nHistory s_bloom(0.1);\nHistory s_bspd(1);\nHistory s_at(0);\nHistory s_gain(0.5);\nHistory s_mat(0.3);\nHistory s_noise(0.5);\nHistory s_width(1);\nHistory prev_vel(0);\nHistory prev_sc(0);\nHistory burst_phase(999999);\nHistory burst_vel(0);\nHistory burst_lp(0);\nHistory burst_lp2(0);\nHistory impact_lp(0);\nHistory impact_lp2(0);\nHistory click_cnt(0);\nHistory low_rms(0);\nHistory bloom_env(0);\nHistory dcx0(0);\nHistory dcy0(0);\nHistory dcx1(0);\nHistory dcy1(0);\nHistory update_idx(0);\nHistory prev_struct(-1);\nHistory num_bloom_triplets(0);\nHistory prev_pos(-1);\nHistory prev_angle(-1);\nHistory reartic_damper(1);\nHistory reartic_count(0);\nHistory mal_y1(0);\nHistory mal_y2(0);\nHistory pk_b0(0);\nHistory pk_b1(0);\nHistory pk_b2(0);\n\n\n// =====================================================\n// INITIALIZATION (runs once on first sample)\n// =====================================================\nif (peek(init_flag, 0, 0) < 0.5) {\n    for (i = 0; i < 32; i += 1) {\n        poke(mode_y1, 0, i, 0);\n        poke(mode_y2, 0, i, 0);\n        poke(mode_a1, 0, i, 0);\n        poke(mode_a2, 0, i, 0);\n        poke(mode_freq, 440, i, 0);\n        poke(mode_detune, 0, i, 0);\n        poke(mode_output, 0, i, 0);\n        poke(current_ratios, i + 1, i, 0);\n        poke(pos_gain, 0.5, i, 0);\n    }\n\n    // --- Ratio tables (5 structure types x 32 modes) ---\n\n    // Channel 0: Harmonic\n    poke(ratio_table, 1.000, 0, 0);\n    poke(ratio_table, 2.000, 1, 0);\n    poke(ratio_table, 3.000, 2, 0);\n    poke(ratio_table, 4.000, 3, 0);\n    poke(ratio_table, 5.000, 4, 0);\n    poke(ratio_table, 6.000, 5, 0);\n    poke(ratio_table, 7.000, 6, 0);\n    poke(ratio_table, 8.000, 7, 0);\n    poke(ratio_table, 9.000, 8, 0);\n    poke(ratio_table, 10.000, 9, 0);\n    poke(ratio_table, 11.000, 10, 0);\n    poke(ratio_table, 12.000, 11, 0);\n    poke(ratio_table, 13.000, 12, 0);\n    poke(ratio_table, 14.000, 13, 0);\n    poke(ratio_table, 15.000, 14, 0);\n    poke(ratio_table, 16.000, 15, 0);\n    poke(ratio_table, 17.000, 16, 0);\n    poke(ratio_table, 18.000, 17, 0);\n    poke(ratio_table, 19.000, 18, 0);\n    poke(ratio_table, 20.000, 19, 0);\n    poke(ratio_table, 21.000, 20, 0);\n    poke(ratio_table, 22.000, 21, 0);\n    poke(ratio_table, 23.000, 22, 0);\n    poke(ratio_table, 24.000, 23, 0);\n    poke(ratio_table, 25.000, 24, 0);\n    poke(ratio_table, 26.000, 25, 0);\n    poke(ratio_table, 27.000, 26, 0);\n    poke(ratio_table, 28.000, 27, 0);\n    poke(ratio_table, 29.000, 28, 0);\n    poke(ratio_table, 30.000, 29, 0);\n    poke(ratio_table, 31.000, 30, 0);\n    poke(ratio_table, 32.000, 31, 0);\n    // Channel 1: Gamelan (ombak beating)\n    poke(ratio_table, 1.000, 0, 1);\n    poke(ratio_table, 1.005, 1, 1);\n    poke(ratio_table, 2.010, 2, 1);\n    poke(ratio_table, 2.035, 3, 1);\n    poke(ratio_table, 3.050, 4, 1);\n    poke(ratio_table, 3.085, 5, 1);\n    poke(ratio_table, 4.120, 6, 1);\n    poke(ratio_table, 4.170, 7, 1);\n    poke(ratio_table, 5.220, 8, 1);\n    poke(ratio_table, 5.285, 9, 1);\n    poke(ratio_table, 6.360, 10, 1);\n    poke(ratio_table, 6.440, 11, 1);\n    poke(ratio_table, 7.530, 12, 1);\n    poke(ratio_table, 7.625, 13, 1);\n    poke(ratio_table, 8.730, 14, 1);\n    poke(ratio_table, 8.845, 15, 1);\n    poke(ratio_table, 9.960, 16, 1);\n    poke(ratio_table, 10.090, 17, 1);\n    poke(ratio_table, 11.220, 18, 1);\n    poke(ratio_table, 11.370, 19, 1);\n    poke(ratio_table, 12.510, 20, 1);\n    poke(ratio_table, 12.680, 21, 1);\n    poke(ratio_table, 13.830, 22, 1);\n    poke(ratio_table, 14.020, 23, 1);\n    poke(ratio_table, 15.180, 24, 1);\n    poke(ratio_table, 15.390, 25, 1);\n    poke(ratio_table, 16.560, 26, 1);\n    poke(ratio_table, 16.790, 27, 1);\n    poke(ratio_table, 17.970, 28, 1);\n    poke(ratio_table, 18.220, 29, 1);\n    poke(ratio_table, 19.410, 30, 1);\n    poke(ratio_table, 19.680, 31, 1);\n    // Channel 2: Nipple gong\n    poke(ratio_table, 1.000, 0, 2);\n    poke(ratio_table, 1.483, 1, 2);\n    poke(ratio_table, 1.986, 2, 2);\n    poke(ratio_table, 2.514, 3, 2);\n    poke(ratio_table, 2.998, 4, 2);\n    poke(ratio_table, 3.523, 5, 2);\n    poke(ratio_table, 4.011, 6, 2);\n    poke(ratio_table, 4.524, 7, 2);\n    poke(ratio_table, 5.033, 8, 2);\n    poke(ratio_table, 5.571, 9, 2);\n    poke(ratio_table, 6.092, 10, 2);\n    poke(ratio_table, 6.631, 11, 2);\n    poke(ratio_table, 7.098, 12, 2);\n    poke(ratio_table, 7.645, 13, 2);\n    poke(ratio_table, 8.153, 14, 2);\n    poke(ratio_table, 8.691, 15, 2);\n    poke(ratio_table, 9.210, 16, 2);\n    poke(ratio_table, 9.748, 17, 2);\n    poke(ratio_table, 10.267, 18, 2);\n    poke(ratio_table, 10.805, 19, 2);\n    poke(ratio_table, 11.324, 20, 2);\n    poke(ratio_table, 11.862, 21, 2);\n    poke(ratio_table, 12.381, 22, 2);\n    poke(ratio_table, 12.919, 23, 2);\n    poke(ratio_table, 13.438, 24, 2);\n    poke(ratio_table, 13.976, 25, 2);\n    poke(ratio_table, 14.495, 26, 2);\n    poke(ratio_table, 15.033, 27, 2);\n    poke(ratio_table, 15.552, 28, 2);\n    poke(ratio_table, 16.090, 29, 2);\n    poke(ratio_table, 16.609, 30, 2);\n    poke(ratio_table, 17.147, 31, 2);\n    // Channel 3: Church bell\n    poke(ratio_table, 0.500, 0, 3);\n    poke(ratio_table, 1.000, 1, 3);\n    poke(ratio_table, 1.183, 2, 3);\n    poke(ratio_table, 1.506, 3, 3);\n    poke(ratio_table, 2.000, 4, 3);\n    poke(ratio_table, 2.514, 5, 3);\n    poke(ratio_table, 2.662, 6, 3);\n    poke(ratio_table, 3.011, 7, 3);\n    poke(ratio_table, 3.520, 8, 3);\n    poke(ratio_table, 4.065, 9, 3);\n    poke(ratio_table, 4.190, 10, 3);\n    poke(ratio_table, 5.255, 11, 3);\n    poke(ratio_table, 5.398, 12, 3);\n    poke(ratio_table, 6.009, 13, 3);\n    poke(ratio_table, 6.584, 14, 3);\n    poke(ratio_table, 7.223, 15, 3);\n    poke(ratio_table, 7.890, 16, 3);\n    poke(ratio_table, 8.541, 17, 3);\n    poke(ratio_table, 9.245, 18, 3);\n    poke(ratio_table, 9.912, 19, 3);\n    poke(ratio_table, 10.628, 20, 3);\n    poke(ratio_table, 11.312, 21, 3);\n    poke(ratio_table, 12.043, 22, 3);\n    poke(ratio_table, 12.750, 23, 3);\n    poke(ratio_table, 13.489, 24, 3);\n    poke(ratio_table, 14.208, 25, 3);\n    poke(ratio_table, 14.960, 26, 3);\n    poke(ratio_table, 15.697, 27, 3);\n    poke(ratio_table, 16.462, 28, 3);\n    poke(ratio_table, 17.213, 29, 3);\n    poke(ratio_table, 17.989, 30, 3);\n    poke(ratio_table, 18.754, 31, 3);\n    // Channel 4: Tam-tam\n    poke(ratio_table, 1.000, 0, 4);\n    poke(ratio_table, 1.593, 1, 4);\n    poke(ratio_table, 2.136, 2, 4);\n    poke(ratio_table, 2.296, 3, 4);\n    poke(ratio_table, 2.653, 4, 4);\n    poke(ratio_table, 2.917, 5, 4);\n    poke(ratio_table, 3.156, 6, 4);\n    poke(ratio_table, 3.501, 7, 4);\n    poke(ratio_table, 3.600, 8, 4);\n    poke(ratio_table, 4.060, 9, 4);\n    poke(ratio_table, 4.154, 10, 4);\n    poke(ratio_table, 4.480, 11, 4);\n    poke(ratio_table, 4.715, 12, 4);\n    poke(ratio_table, 5.193, 13, 4);\n    poke(ratio_table, 5.500, 14, 4);\n    poke(ratio_table, 5.956, 15, 4);\n    poke(ratio_table, 6.350, 16, 4);\n    poke(ratio_table, 6.780, 17, 4);\n    poke(ratio_table, 7.150, 18, 4);\n    poke(ratio_table, 7.580, 19, 4);\n    poke(ratio_table, 7.960, 20, 4);\n    poke(ratio_table, 8.400, 21, 4);\n    poke(ratio_table, 8.810, 22, 4);\n    poke(ratio_table, 9.260, 23, 4);\n    poke(ratio_table, 9.680, 24, 4);\n    poke(ratio_table, 10.130, 25, 4);\n    poke(ratio_table, 10.570, 26, 4);\n    poke(ratio_table, 11.040, 27, 4);\n    poke(ratio_table, 11.490, 28, 4);\n    poke(ratio_table, 11.970, 29, 4);\n    poke(ratio_table, 12.430, 30, 4);\n    poke(ratio_table, 12.920, 31, 4);\n\n\n    // --- Decay tables (5 structure types x 32 modes) ---\n    // Values are T60 multipliers on base decay_time\n\n    // Channel 0: Harmonic \u2014 uniform (frequency rolloff handles it)\n    for (i = 0; i < 32; i += 1) {\n        poke(decay_table, 1.0, i, 0);\n    }\n\n    // Channel 1: Gamelan \u2014 mid-focused sustain (singing tones ring)\n    for (i = 0; i < 32; i += 1) {\n        gam_mid = exp(-0.5 * pow((i - 9.0) / 5.0, 2));\n        poke(decay_table, 0.6 + gam_mid * 0.8, i, 1);\n    }\n\n    // Channel 2: Nipple gong \u2014 strong fundamental, moderate rolloff\n    for (i = 0; i < 32; i += 1) {\n        nip_fund = exp(-i * 0.2);\n        poke(decay_table, 0.7 + nip_fund * 0.8, i, 2);\n    }\n\n    // Channel 3: Church bell \u2014 massive hum sustain, strike note present\n    for (i = 0; i < 32; i += 1) {\n        bell_hum = exp(-i * 0.4) * 2.6;\n        bell_nom = exp(-0.5 * pow((i - 4.0) / 2.0, 2)) * 0.3;\n        poke(decay_table, 0.4 + bell_hum + bell_nom, i, 3);\n    }\n\n    // Channel 4: Tam-tam \u2014 fast upper decay, deep fundamental wash\n    for (i = 0; i < 32; i += 1) {\n        tam_curve = exp(-i * 0.12);\n        poke(decay_table, 0.15 + tam_curve * 1.35, i, 4);\n    }\n\n    // Coupling triplets [modeA, modeB, modeC, strength]\n    poke(coupling_map, 0, 0, 0); poke(coupling_map, 0, 0, 1); poke(coupling_map, 1, 0, 2); poke(coupling_map, 0, 0, 3);\n    poke(coupling_map, 0, 1, 0); poke(coupling_map, 1, 1, 1); poke(coupling_map, 2, 1, 2); poke(coupling_map, 0, 1, 3);\n    poke(coupling_map, 0, 2, 0); poke(coupling_map, 1, 2, 1); poke(coupling_map, 3, 2, 2); poke(coupling_map, 0, 2, 3);\n    poke(coupling_map, 0, 3, 0); poke(coupling_map, 2, 3, 1); poke(coupling_map, 4, 3, 2); poke(coupling_map, 0, 3, 3);\n    poke(coupling_map, 1, 4, 0); poke(coupling_map, 1, 4, 1); poke(coupling_map, 3, 4, 2); poke(coupling_map, 0, 4, 3);\n    poke(coupling_map, 0, 5, 0); poke(coupling_map, 3, 5, 1); poke(coupling_map, 5, 5, 2); poke(coupling_map, 0, 5, 3);\n    poke(coupling_map, 1, 6, 0); poke(coupling_map, 2, 6, 1); poke(coupling_map, 5, 6, 2); poke(coupling_map, 0, 6, 3);\n    poke(coupling_map, 1, 7, 0); poke(coupling_map, 3, 7, 1); poke(coupling_map, 6, 7, 2); poke(coupling_map, 0, 7, 3);\n    poke(coupling_map, 2, 8, 0); poke(coupling_map, 2, 8, 1); poke(coupling_map, 6, 8, 2); poke(coupling_map, 0, 8, 3);\n    poke(coupling_map, 0, 9, 0); poke(coupling_map, 4, 9, 1); poke(coupling_map, 7, 9, 2); poke(coupling_map, 0, 9, 3);\n    poke(coupling_map, 2, 10, 0); poke(coupling_map, 3, 10, 1); poke(coupling_map, 7, 10, 2); poke(coupling_map, 0, 10, 3);\n    poke(coupling_map, 1, 11, 0); poke(coupling_map, 4, 11, 1); poke(coupling_map, 8, 11, 2); poke(coupling_map, 0, 11, 3);\n    poke(coupling_map, 3, 12, 0); poke(coupling_map, 3, 12, 1); poke(coupling_map, 8, 12, 2); poke(coupling_map, 0, 12, 3);\n    poke(coupling_map, 2, 13, 0); poke(coupling_map, 4, 13, 1); poke(coupling_map, 9, 13, 2); poke(coupling_map, 0, 13, 3);\n    poke(coupling_map, 3, 14, 0); poke(coupling_map, 4, 14, 1); poke(coupling_map, 10, 14, 2); poke(coupling_map, 0, 14, 3);\n    poke(coupling_map, 0, 15, 0); poke(coupling_map, 5, 15, 1); poke(coupling_map, 9, 15, 2); poke(coupling_map, 0, 15, 3);\n\n    // Material parameters: [contact_ms, impact_ratio, lpf_lo, lpf_hi, mal_ctr, mal_q, mal_exp]\n    // mal_exp is the Hertzian contact power-law exponent (soft=low, hard=high)\n    // Wool (long, dark, almost no impact click)\n    poke(mat_params, 12, 0, 0);   poke(mat_params, 0.1, 0, 1);  poke(mat_params, 200, 0, 2);   poke(mat_params, 1500, 0, 3);\n    poke(mat_params, 800, 0, 4);  poke(mat_params, 1.0, 0, 5);  poke(mat_params, 1.8, 0, 6);\n    // Felt (warm, moderate)\n    poke(mat_params, 7, 1, 0);    poke(mat_params, 0.2, 1, 1);  poke(mat_params, 400, 1, 2);   poke(mat_params, 5000, 1, 3);\n    poke(mat_params, 1200, 1, 4); poke(mat_params, 1.5, 1, 5);  poke(mat_params, 2.2, 1, 6);\n    // Rubber (punchy, mid-range)\n    poke(mat_params, 4, 2, 0);    poke(mat_params, 0.35, 2, 1); poke(mat_params, 800, 2, 2);   poke(mat_params, 10000, 2, 3);\n    poke(mat_params, 1800, 2, 4); poke(mat_params, 2.0, 2, 5);  poke(mat_params, 2.8, 2, 6);\n    // Wood (bright, articulate)\n    poke(mat_params, 2, 3, 0);    poke(mat_params, 0.55, 3, 1); poke(mat_params, 2000, 3, 2);  poke(mat_params, 16000, 3, 3);\n    poke(mat_params, 2800, 3, 4); poke(mat_params, 2.5, 3, 5);  poke(mat_params, 3.5, 3, 6);\n    // Metal (sharp, brilliant)\n    poke(mat_params, 0.8, 4, 0);  poke(mat_params, 0.75, 4, 1); poke(mat_params, 4000, 4, 2);  poke(mat_params, 20000, 4, 3);\n    poke(mat_params, 4000, 4, 4); poke(mat_params, 3.5, 4, 5);  poke(mat_params, 5.0, 4, 6);\n\n    // Compute valid coefficients for all 32 modes immediately\n    // (don't rely on round-robin update which takes 32 samples)\n    init_struct = 0.5;\n    init_fidx = init_struct * 4.0;\n    init_rlo = floor(init_fidx);\n    init_rhi = min(init_rlo + 1, 4);\n    init_frac = init_fidx - init_rlo;\n    for (i = 0; i < 32; i += 1) {\n        rl = peek(ratio_table, i, init_rlo);\n        rh = peek(ratio_table, i, init_rhi);\n        init_ratio = rl + (rh - rl) * init_frac;\n        poke(current_ratios, init_ratio, i, 0);\n\n        init_f = 110 * init_ratio;\n        init_f = min(init_f, samplerate * 0.49);\n        poke(mode_freq, init_f, i, 0);\n\n        // Init decay multiplier (interpolated from decay_table)\n        init_dl = peek(decay_table, i, init_rlo);\n        init_dh = peek(decay_table, i, init_rhi);\n        init_decay_mult = init_dl + (init_dh - init_dl) * init_frac;\n        poke(current_decays, init_decay_mult, i, 0);\n\n        // Default brightness=0.5 -> damp_slope=0.5\n        init_t60 = 8.0 * init_decay_mult * pow(max(init_ratio, 0.1), -0.5);\n        init_t60 = max(init_t60, 0.01);\n        init_r = exp(-6.9078 / (init_t60 * samplerate));\n        init_theta = TWOPI * init_f / samplerate;\n        poke(mode_a1, 2.0 * init_r * cos(init_theta), i, 0);\n        poke(mode_a2, -(init_r * init_r), i, 0);\n\n        // Init position gains for pos=0.5, angle=0.5\n        angle_init = max(0.15, 0.5 + 0.5 * cos(TWOPI * 0.5 * (floor(i / 2) + 1)));\n        raw_pg = sin(PI * 0.5 * (i + 1)) * angle_init;\n        pg_sign = raw_pg >= 0 ? 1 : -1;\n        poke(pos_gain, pg_sign * max(abs(raw_pg), 0.12), i, 0);\n    }\n\n    // Compute initial coupling strengths from frequency proximity\n    // (explicit init, don't rely on structure-change trigger)\n    for (t = 0; t < 16; t += 1) {\n        init_a = peek(coupling_map, t, 0);\n        init_b = peek(coupling_map, t, 1);\n        init_c = peek(coupling_map, t, 2);\n        init_ra = peek(current_ratios, init_a, 0);\n        init_rb = peek(current_ratios, init_b, 0);\n        init_rc = peek(current_ratios, init_c, 0);\n        init_sum = init_ra + init_rb;\n        init_prox = abs(init_rc - init_sum) / max(init_sum, 0.001);\n        poke(coupling_map, max(1.0 - init_prox * 33.33, 0) * 0.00005, t, 3);\n    }\n\n    poke(init_flag, 1, 0, 0);\n}\n\n\n// =====================================================\n// 1. PARAMETER SMOOTHING (one-pole, ~23ms convergence)\n// =====================================================\nsm = 0.001;\ns_freq = s_freq + (base_freq - s_freq) * sm;\ns_struct = s_struct + (structure - s_struct) * sm;\ns_bright = s_bright + (brightness - s_bright) * sm;\ns_decay = s_decay + (decay_time - s_decay) * sm;\ns_pos = s_pos + (position - s_pos) * sm;\ns_angle = s_angle + (excitation_angle - s_angle) * sm;\ns_nonlin = s_nonlin + (nonlinearity - s_nonlin) * sm;\ns_hard = s_hard + (mallet_hardness - s_hard) * sm;\ns_bloom = s_bloom + (bloom_amount - s_bloom) * sm;\ns_bspd = s_bspd + (bloom_speed - s_bspd) * sm;\ns_at = s_at + (aftertouch - s_at) * sm;\ns_gain = s_gain + (output_gain - s_gain) * sm;\ns_mat = s_mat + (material - s_mat) * sm;\ns_noise = s_noise + (noise_level - s_noise) * sm;\ns_width = s_width + (stereo_width - s_width) * sm;\n\n\n// =====================================================\n// 2. RATIO TABLE INTERPOLATION (when structure changes)\n// =====================================================\nif (abs(s_struct - prev_struct) > 0.0001) {\n    prev_struct = s_struct;\n\n    frac_idx = s_struct * 4.0;\n    row_lo = floor(frac_idx);\n    row_hi = min(row_lo + 1, 4);\n    frac = frac_idx - row_lo;\n\n    for (m = 0; m < 32; m += 1) {\n        r_lo = peek(ratio_table, m, row_lo);\n        r_hi = peek(ratio_table, m, row_hi);\n        poke(current_ratios, r_lo + (r_hi - r_lo) * frac, m, 0);\n\n        d_lo = peek(decay_table, m, row_lo);\n        d_hi = peek(decay_table, m, row_hi);\n        poke(current_decays, d_lo + (d_hi - d_lo) * frac, m, 0);\n    }\n\n    // Update coupling strengths from frequency proximity\n    for (t = 0; t < 16; t += 1) {\n        a_idx = peek(coupling_map, t, 0);\n        b_idx = peek(coupling_map, t, 1);\n        c_idx = peek(coupling_map, t, 2);\n        ra = peek(current_ratios, a_idx, 0);\n        rb = peek(current_ratios, b_idx, 0);\n        rc = peek(current_ratios, c_idx, 0);\n        sum_ab = ra + rb;\n        prox = abs(rc - sum_ab) / max(sum_ab, 0.001);\n        poke(coupling_map, max(1.0 - prox * 33.33, 0) * 0.00005, t, 3);\n    }\n\n    // Dynamically discover bloom coupling triplets from current ratios.\n    // For each mode pair (i<=j, i<nm) find mode k nearest to (ri+rj) (sum tone)\n    // and nearest to |ri-rj| (difference tone). Accept when detuning < 5%.\n    // Strength tapers linearly with detuning; cap at 64 triplets.\n    nm_bt = floor(num_modes);\n    bt_cnt = 0;\n    for (bi = 0; bi < 32; bi += 1) {\n        if (bi < nm_bt) {\n            if (bt_cnt < 64) {\n                for (bj = 0; bj < 32; bj += 1) {\n                    if (bj >= bi) {\n                        if (bj < nm_bt) {\n                            if (bt_cnt < 64) {\n                                ri = peek(current_ratios, bi, 0);\n                                rj = peek(current_ratios, bj, 0);\n                                sum_ij = ri + rj;\n\n                                // Find k closest to sum tone\n                                best_k_s = 0;\n                                best_det_s = 1e9;\n                                for (bk = 0; bk < 32; bk += 1) {\n                                    if (bk < nm_bt) {\n                                        rk = peek(current_ratios, bk, 0);\n                                        det_s = abs(rk - sum_ij) / max(sum_ij, 0.001);\n                                        if (det_s < best_det_s) {\n                                            best_det_s = det_s;\n                                            best_k_s = bk;\n                                        }\n                                    }\n                                }\n                                if (best_det_s < 0.05) {\n                                    if (bt_cnt < 64) {\n                                        str_s = max(1.0 - best_det_s * 20.0, 0) * 0.00005;\n                                        poke(bloom_map, bi, bt_cnt, 0);\n                                        poke(bloom_map, bj, bt_cnt, 1);\n                                        poke(bloom_map, best_k_s, bt_cnt, 2);\n                                        poke(bloom_map, str_s, bt_cnt, 3);\n                                        bt_cnt = bt_cnt + 1;\n                                    }\n                                }\n\n                                // Difference tone (skip when bi == bj: diff is 0)\n                                if (bj > bi) {\n                                    if (bt_cnt < 64) {\n                                        diff_ij = abs(ri - rj);\n                                        best_k_d = 0;\n                                        best_det_d = 1e9;\n                                        for (bk2 = 0; bk2 < 32; bk2 += 1) {\n                                            if (bk2 < nm_bt) {\n                                                rk2 = peek(current_ratios, bk2, 0);\n                                                det_d = abs(rk2 - diff_ij) / max(diff_ij, 0.001);\n                                                if (det_d < best_det_d) {\n                                                    best_det_d = det_d;\n                                                    best_k_d = bk2;\n                                                }\n                                            }\n                                        }\n                                        if (best_det_d < 0.05) {\n                                            if (bt_cnt < 64) {\n                                                str_d = max(1.0 - best_det_d * 20.0, 0) * 0.00005;\n                                                poke(bloom_map, bi, bt_cnt, 0);\n                                                poke(bloom_map, bj, bt_cnt, 1);\n                                                poke(bloom_map, best_k_d, bt_cnt, 2);\n                                                poke(bloom_map, str_d, bt_cnt, 3);\n                                                bt_cnt = bt_cnt + 1;\n                                            }\n                                        }\n                                    }\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n    num_bloom_triplets = bt_cnt;\n}\n\n\n// =====================================================\n// 3. POSITION GAIN UPDATE (when position or angle changes)\n// =====================================================\nif (abs(s_pos - prev_pos) > 0.0001 || abs(s_angle - prev_angle) > 0.0001) {\n    prev_pos = s_pos;\n    prev_angle = s_angle;\n    for (m = 0; m < 32; m += 1) {\n        angle_mod = max(0.15, 0.5 + 0.5 * cos(TWOPI * s_angle * (floor(m / 2) + 1)));\n        raw_pg = sin(PI * s_pos * (m + 1)) * angle_mod;\n        pg_sign = raw_pg >= 0 ? 1 : -1;\n        poke(pos_gain, pg_sign * max(abs(raw_pg), 0.12), m, 0);\n    }\n}\n\n\n// =====================================================\n// 4. COEFFICIENT UPDATE (1 mode per sample, cycles continuously)\n// =====================================================\nm_upd = floor(update_idx);\nupdate_idx = update_idx + 1;\nif (update_idx >= 32) {\n    update_idx = 0;\n}\n\nratio = peek(current_ratios, m_upd, 0);\ndt_offset = peek(mode_detune, m_upd, 0) * detune * 0.02;\nfreq = s_freq * ratio * (1.0 + dt_offset);\nfreq = min(freq, samplerate * 0.49);\npoke(mode_freq, freq, m_upd, 0);\n\n// Frequency-dependent decay: higher modes decay faster\n// brightness=1 -> gentle slope (bright), brightness=0 -> steep slope (dark)\n// decay_mult: per-structure profile from decay_table\ndamp_slope = 0.7 - s_bright * 0.4;\ndecay_mult = peek(current_decays, m_upd, 0);\nt60 = s_decay * decay_mult * pow(max(ratio, 0.1), -damp_slope);\nt60 = max(t60, 0.1);\n\nr = exp(-6.9078 / (t60 * samplerate));\ntheta = TWOPI * freq / samplerate;\n\n// Apply nonlinear pitch glide (amplitude-dependent frequency shift)\n// Use smoothed envelope, not raw sample (avoids FM artifacts at zero crossings)\nraw_amp = abs(peek(mode_y1, m_upd, 0));\nenv_prev = peek(mode_env, m_upd, 0);\nenv_coeff = 0.001;\nenv = env_prev + (raw_amp - env_prev) * env_coeff;\npoke(mode_env, env, m_upd, 0);\n// Real gong nonlinearity: omega_NL = omega_0 * sqrt(1 + beta * (A/h)^2)\n// Cap at 1.5x frequency shift (extreme hard strike at max nonlinearity)\nnl_mod = 1.0 + s_nonlin * clamp(env * env, 0, 1) * 0.5;\ntheta_nl = TWOPI * min(freq * nl_mod, samplerate * 0.49) / samplerate;\n\npoke(mode_a1, 2.0 * r * cos(theta_nl), m_upd, 0);\npoke(mode_a2, -(r * r), m_upd, 0);\n\n\n// =====================================================\n// 5. TRIGGER DETECTION + REARTICULATION\n// =====================================================\n// Two trigger paths:\n// (a) MIDI: velocity rises from 0 (note-off resets to 0)\n// (b) Test button: strike_count increments (always unique)\nvel = velocity;\nsc = strike_count;\nmidi_onset = (vel > 0.01 && prev_vel < 0.01) ? 1 : 0;\ncount_onset = (sc != prev_sc) ? 1 : 0;\nonset = (midi_onset > 0.5 || count_onset > 0.5) ? 1 : 0;\n// Use vel for force; if triggered by count, use stored strike_force\nif (count_onset > 0.5 && midi_onset < 0.5) {\n    vel = strike_force;\n}\nprev_vel = velocity;\nprev_sc = sc;\n\nif (onset > 0.5) {\n    // Rearticulation: exponential damp over 2ms to avoid click\n    // Soft mallet preserves more ringing, hard mallet kills more\n    reartic_n = floor(0.002 * samplerate);\n    reartic_level = 0.05 + (1.0 - s_hard) * 0.75;\n    reartic_damper = pow(reartic_level, 1.0 / max(reartic_n, 1));\n    reartic_count = reartic_n;\n\n    burst_vel = pow(vel, vel_curve);\n    burst_phase = 0;\n    // Regenerate per-mode random detune offsets on each strike\n    for (di = 0; di < 32; di += 1) {\n        poke(mode_detune, noise(), di, 0);\n    }\n    impact_lp = 0;\n    impact_lp2 = 0;\n    click_cnt = samplerate * 0.0002;\n    burst_lp = 0;\n    burst_lp2 = 0;\n    bloom_env = bloom_env * bloom_persist;  // preserve fraction of bloom on new strike\n    mal_y1 = 0;\n    mal_y2 = 0;\n}\n\n// Apply rearticulation decay (constant per-sample multiplier over N samples)\nif (reartic_count > 0) {\n    for (md = 0; md < 32; md += 1) {\n        y1_old = peek(mode_y1, md, 0);\n        y2_old = peek(mode_y2, md, 0);\n        poke(mode_y1, y1_old * reartic_damper, md, 0);\n        poke(mode_y2, y2_old * reartic_damper, md, 0);\n    }\n    reartic_count = reartic_count - 1;\n}\n\n\n// =====================================================\n// 6. EXCITATION (Hertzian mallet model + body resonance)\n// =====================================================\n\n// --- Material interpolation (5-point piecewise linear) ---\n// wool(0) -> felt(0.25) -> rubber(0.5) -> wood(0.75) -> metal(1.0)\nmat4 = s_mat * 4.0;\nmat_lo = floor(mat4);\nmat_hi = min(mat_lo + 1, 4);\nmat_frac = mat4 - mat_lo;\n\ncontact_ms = peek(mat_params, mat_lo, 0) + (peek(mat_params, mat_hi, 0) - peek(mat_params, mat_lo, 0)) * mat_frac;\nlpf_lo_freq = peek(mat_params, mat_lo, 2) + (peek(mat_params, mat_hi, 2) - peek(mat_params, mat_lo, 2)) * mat_frac;\nlpf_hi_freq = peek(mat_params, mat_lo, 3) + (peek(mat_params, mat_hi, 3) - peek(mat_params, mat_lo, 3)) * mat_frac;\nmal_ctr = peek(mat_params, mat_lo, 4) + (peek(mat_params, mat_hi, 4) - peek(mat_params, mat_lo, 4)) * mat_frac;\nmal_qv = peek(mat_params, mat_lo, 5) + (peek(mat_params, mat_hi, 5) - peek(mat_params, mat_lo, 5)) * mat_frac;\nmal_exp = peek(mat_params, mat_lo, 6) + (peek(mat_params, mat_hi, 6) - peek(mat_params, mat_lo, 6)) * mat_frac;\n\n// Velocity-dependent contact via Hertzian power-law scaling\n// Softer/quieter strikes stretch contact; harder strikes compress it\n// Higher mal_exp (metal) -> stronger velocity dependence; lower exp (wool) -> milder\nvel_duration_scale = pow(max(burst_vel, 0.05), (1.0 - mal_exp) / (2.0 * mal_exp));\neff_contact_ms = contact_ms * (1.0 - s_hard * 0.3) * vel_duration_scale;\ncontact_samps = eff_contact_ms * 0.001 * samplerate;\n\n// Advance burst phase\nburst_phase = min(burst_phase + 1, 100000);\n\n// --- Mallet contact envelope (Hertzian pulse + exponential tail) ---\n// Contact window [0, T]: sin(PI * t/T)^mal_exp\n//   Felt (p~2.2) -> smooth broad hump\n//   Metal (p~5)  -> narrow sharp spike\n// After contact: small exponential tail models mallet separation residual\nsafe_contact = max(contact_samps, 1);\npulse_norm = min(burst_phase / safe_contact, 1.0);\nsin_val = sin(PI * pulse_norm);\npulse_shape = pow(max(sin_val, 0), mal_exp);\n\ntail_tau = contact_samps * (1.0 + (1.0 - s_hard) * 2.0);\ntail_phase = max(burst_phase - contact_samps, 0);\ntail_level = 0.15;\ntail_amp = tail_level * exp(-tail_phase / max(tail_tau, 1));\n\nin_contact = burst_phase < contact_samps ? 1.0 : 0.0;\nhertz_env = (pulse_shape * in_contact + tail_amp * (1.0 - in_contact)) * burst_vel;\n\n// --- Shaped noise source (pink/white blend) ---\n// 3-stage Paul Kellet filter for accurate -3dB/oct pink spectrum\n// Soft materials get more low-frequency emphasis (warmer thud)\n// Hard materials stay broadband (crisp attack)\nwhite = noise();\npk_b0 = 0.99765 * pk_b0 + white * 0.0990460;\npk_b1 = 0.96300 * pk_b1 + white * 0.2965164;\npk_b2 = 0.57000 * pk_b2 + white * 1.0526913;\npink_out = (pk_b0 + pk_b1 + pk_b2 + white * 0.1848) * 0.22;\npink_blend = clamp(1.0 - s_mat * 1.5, 0, 1);\nshaped_noise = white * (1.0 - pink_blend) + pink_out * pink_blend;\n\n// --- Mallet body resonance (2nd-order bandpass) ---\n// Models the tonal character of the mallet head vibrating on contact\n// Velocity shifts center frequency up (harder impact = brighter mallet)\nmal_freq_eff = mal_ctr * (1.0 + burst_vel * 0.5);\nmal_bw = mal_freq_eff / max(mal_qv, 0.5);\nmal_theta = TWOPI * min(mal_freq_eff, samplerate * 0.49) / samplerate;\nmal_rv = exp(-PI * mal_bw / samplerate);\nmal_a1c = 2.0 * mal_rv * cos(mal_theta);\nmal_a2c = -(mal_rv * mal_rv);\nmal_y = mal_a1c * mal_y1 + mal_a2c * mal_y2 + shaped_noise;\nmal_y2 = mal_y1;\nmal_y1 = mal_y;\n\n// Blend broadband and resonated: soft materials = more body resonance\nres_mix = clamp(1.0 - s_mat, 0.15, 0.85);\nmallet_noise = shaped_noise * (1.0 - res_mix) + mal_y * res_mix * 0.3;\n\n// --- Material lowpass filter (2-pole on Hertz-enveloped noise) ---\nraw_exc = mallet_noise * hertz_env;\n// Initial contact impulse: broadband click for hard mallets (wood/metal range)\nimpulse_gain = clamp(s_mat - 0.5, 0, 1) * 2.0;\nclick_sample = noise() * impulse_gain * burst_vel * (click_cnt > 0);\nclick_cnt = max(click_cnt - 1, 0);\nraw_exc = raw_exc + click_sample;\n// Mallet bounce: secondary contact ~8ms after strike for hard mallets at high velocity\nbounce_delay_samps = samplerate * 0.008;\nbounce_width_samps = samplerate * 0.002;\nbounce_t = burst_phase - bounce_delay_samps;\nbounce_active = (bounce_t >= 0) * (bounce_t < bounce_width_samps);\nbounce_env = sin(PI * bounce_t / max(bounce_width_samps, 1.0)) * bounce_active;\nbounce_strength = clamp(s_mat - 0.4, 0, 1) * burst_vel * burst_vel * 0.15;\nraw_exc = raw_exc + mallet_noise * bounce_env * bounce_strength;\n// Velocity-dependent brightness: ff strikes up to 3x brighter than pp\nvel_bright = 1.0 + burst_vel * burst_vel * 2.0;\nbody_cut = (lpf_lo_freq + s_hard * (lpf_hi_freq - lpf_lo_freq)) * vel_bright;\nbody_cut = min(body_cut, samplerate * 0.45);\nbody_coeff = 1.0 - exp(-TWOPI * body_cut / samplerate);\nburst_lp = burst_lp + body_coeff * (raw_exc - burst_lp);\nburst_lp2 = burst_lp2 + body_coeff * (burst_lp - burst_lp2);\n\n// --- Mix: excitation for resonators + audio input ---\naudio_in = in1;\nr_avg = exp(-6.9078 / (max(s_decay, 0.1) * samplerate));\nq_comp = sqrt(1.0 - r_avg * r_avg);\nexc_norm = clamp(s_freq / 220.0, 0.1, 10.0) * q_comp;\nexcitation = (burst_lp2 + audio_in) * exc_norm;\n\n\n// =====================================================\n// 7. RESONATOR BANK (32 parallel 2nd-order resonators)\n// =====================================================\nsum_L = 0;\nsum_R = 0;\nnm = floor(num_modes);\n\n// Aftertouch damping coefficient (per-sample)\nat_damp = s_at > 0.005 ? (1.0 - s_at * 0.0003) : 1.0;\n\nfor (m = 0; m < 32; m += 1) {\n    a1 = peek(mode_a1, m, 0);\n    a2 = peek(mode_a2, m, 0);\n    y1 = peek(mode_y1, m, 0);\n    y2 = peek(mode_y2, m, 0);\n\n    // Excitation gain: exponential rolloff driven by hardness\n    // Soft mallet strongly suppresses high modes, hard mallet excites all\n    rolloff_exp = (1.0 - s_hard) * 3.0 + 0.5;\n    mode_rolloff = pow(max(1.0 - (m / 31.0), 0.001), rolloff_exp);\n    user_gain = peek(mode_gains, m, 0);\n    g = peek(pos_gain, m, 0) * mode_rolloff * (m < nm ? 1.0 : 0.0) * clamp(user_gain, 0, 1);\n\n    // 2nd-order resonator\n    y = a1 * y1 + a2 * y2 + excitation * g;\n\n    // Aftertouch hand-damping\n    y = y * at_damp;\n\n    poke(mode_y1, y, m, 0);\n    poke(mode_y2, y1, m, 0);\n    poke(mode_output, y, m, 0);\n\n    // Stereo: golden-ratio distribution across stereo field\n    // phi^-1 = 0.6180339887 gives maximal mode separation\n    gr_raw = m * 0.6180339887;\n    gr_pan = gr_raw - floor(gr_raw);\n    // stereo_width: 0 = mono (center), 1 = full spread\n    eff_pan = 0.5 + (gr_pan - 0.5) * s_width;\n    // Equal-power panning\n    sum_L = sum_L + y * cos(eff_pan * PI * 0.5);\n    sum_R = sum_R + y * sin(eff_pan * PI * 0.5);\n}\n\n// Direct mallet sound (bypasses resonators for audible strike character)\n// Uses mallet-resonated, Hertz-enveloped signal \u2014 natural attack shape\nimpact_direct = burst_lp2 * s_noise * 0.5;\nsum_L = sum_L + impact_direct;\nsum_R = sum_R + impact_direct;\n\n\n// =====================================================\n// 8. NONLINEAR COUPLING (sparse resonant triplets)\n// =====================================================\n// Read from mode_y1 (state) not mode_output (Q-amplified) to prevent\n// positive feedback explosion. Clamp coupling injection per sample.\nnl_scale = s_nonlin;\nfor (t = 0; t < 16; t += 1) {\n    a_idx = peek(coupling_map, t, 0);\n    b_idx = peek(coupling_map, t, 1);\n    c_idx = peek(coupling_map, t, 2);\n    strength = peek(coupling_map, t, 3) * nl_scale;\n\n    ya = peek(mode_y1, a_idx, 0);\n    yb = peek(mode_y1, b_idx, 0);\n\n    // Amplitude-dependent strength: louder modes couple harder (nonlinear energy transfer)\n    amp_peak = max(abs(ya), abs(yb));\n    eff_strength = strength * (1.0 + amp_peak * amp_peak * 100.0);\n\n    // Quadratic coupling with widened clamp to allow stronger transients\n    coupling_term = clamp(ya * yb * eff_strength, -0.005, 0.005);\n\n    // Add to target mode C\n    yc1 = peek(mode_y1, c_idx, 0);\n    poke(mode_y1, yc1 + coupling_term, c_idx, 0);\n    // Subtract from source modes (energy conservation)\n    ya1 = peek(mode_y1, a_idx, 0);\n    yb1 = peek(mode_y1, b_idx, 0);\n    poke(mode_y1, ya1 - coupling_term * 0.5, a_idx, 0);\n    poke(mode_y1, yb1 - coupling_term * 0.5, b_idx, 0);\n}\n\n// --- Dynamic bloom coupling network (sum/difference tone triplets) ---\nbt_active = num_bloom_triplets;\nfor (bt = 0; bt < 64; bt += 1) {\n    if (bt < bt_active) {\n        ba_idx = peek(bloom_map, bt, 0);\n        bb_idx = peek(bloom_map, bt, 1);\n        bc_idx = peek(bloom_map, bt, 2);\n        b_strength = peek(bloom_map, bt, 3) * nl_scale;\n\n        bya = peek(mode_y1, ba_idx, 0);\n        byb = peek(mode_y1, bb_idx, 0);\n\n        b_amp_peak = max(abs(bya), abs(byb));\n        b_eff_strength = b_strength * (1.0 + b_amp_peak * b_amp_peak * 100.0);\n\n        b_coupling_term = clamp(bya * byb * b_eff_strength, -0.005, 0.005);\n\n        byc1 = peek(mode_y1, bc_idx, 0);\n        poke(mode_y1, byc1 + b_coupling_term, bc_idx, 0);\n        bya1 = peek(mode_y1, ba_idx, 0);\n        byb1 = peek(mode_y1, bb_idx, 0);\n        poke(mode_y1, bya1 - b_coupling_term * 0.5, ba_idx, 0);\n        poke(mode_y1, byb1 - b_coupling_term * 0.5, bb_idx, 0);\n    }\n}\n\n\n// =====================================================\n// 9. BLOOM (phenomenological energy cascade)\n// =====================================================\n// Monitor RMS of low modes (0-7)\nlow_sum_sq = 0;\nfor (mb = 0; mb < 8; mb += 1) {\n    y_mb = peek(mode_output, mb, 0);\n    low_sum_sq = low_sum_sq + y_mb * y_mb;\n}\nrms_coeff = exp(-1.0 / (0.01 * samplerate));\nlow_rms = sqrt(low_rms * low_rms * rms_coeff + low_sum_sq / 8.0 * (1.0 - rms_coeff));\n\n// Bloom envelope: rises when low-mode energy exceeds threshold\nbloom_thresh = 0.005;\nbloom_target = (low_rms > bloom_thresh) ? 1.0 : 0.0;\nbloom_rate = 1.0 / (s_bspd * samplerate);\nif (bloom_target > bloom_env) {\n    bloom_env = min(bloom_env + bloom_rate, 1.0);\n} else {\n    bloom_env = max(bloom_env - bloom_rate * 2, 0);\n}\n\n// Coupling-based bloom energy cascade (gated by bloom_env)\n// Iterates bloom_map triplets, driving mode C from ya*yb product of modes A,B\nbloom_nl = s_bloom * (1.0 + low_rms * 10.0);\nif (bloom_env > 0.01) {\n    bt_a = num_bloom_triplets;\n    for (bt2 = 0; bt2 < 64; bt2 += 1) {\n        if (bt2 < bt_a) {\n            ba2 = peek(bloom_map, bt2, 0);\n            bb2 = peek(bloom_map, bt2, 1);\n            bc2 = peek(bloom_map, bt2, 2);\n            bstr = peek(bloom_map, bt2, 3) * bloom_env;\n            ya_bl = peek(mode_y1, ba2, 0);\n            yb_bl = peek(mode_y1, bb2, 0);\n            bloom_inject = clamp(ya_bl * yb_bl * bstr * bloom_nl, -0.01, 0.01);\n            yc_bl = peek(mode_y1, bc2, 0);\n            poke(mode_y1, yc_bl + bloom_inject, bc2, 0);\n            ya_bl2 = peek(mode_y1, ba2, 0);\n            yb_bl2 = peek(mode_y1, bb2, 0);\n            poke(mode_y1, ya_bl2 - bloom_inject * 0.5, ba2, 0);\n            poke(mode_y1, yb_bl2 - bloom_inject * 0.5, bb2, 0);\n        }\n    }\n}\n// Optional turbulent residual into modes 8+ for sustained high-energy states\nif (low_rms > 0.01) {\n    turb_base = low_rms * low_rms * s_bloom * 0.02;\n    for (mt = 8; mt < 32; mt += 1) {\n        mode_amp_mt = abs(peek(mode_y1, mt, 0));\n        turb_inject = clamp(noise() * turb_base * (1.0 + mode_amp_mt * 5.0), -0.002, 0.002);\n        y1_mt = peek(mode_y1, mt, 0);\n        poke(mode_y1, y1_mt + turb_inject, mt, 0);\n    }\n}\n\n\n// =====================================================\n// 10. OUTPUT (scaling + DC blocker)\n// =====================================================\nscale = s_gain / max(sqrt(nm), 1.0);\nwet_L = sum_L * scale;\nwet_R = sum_R * scale;\n\n// DC blocker (same as FDN reverb pattern)\nw0 = wet_L - dcx0 + 0.995 * dcy0;\ndcx0 = wet_L;\ndcy0 = w0;\nw1 = wet_R - dcx1 + 0.995 * dcy1;\ndcx1 = wet_R;\ndcy1 = w1;\n\n// Soft limiter (tanh saturation)\nout1 = tanh(w0);\nout2 = tanh(w1);\n",
