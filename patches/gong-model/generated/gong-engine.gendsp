      "boxes": [
         {
            "box": {
               "maxclass": "newobj",
               "text": "in 1",
               "id": "obj-1",
               "numinlets": 0,
               "numoutlets": 1,
               "outlettype": [
                  ""
               ],
               "patching_rect": [
                  50.0,
