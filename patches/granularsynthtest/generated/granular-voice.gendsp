      {
        "box": {
          "maxclass": "codebox",
          "id": "obj-8",
          "code": "// Granular voice - one instance per MC channel (mc.gen~ granular-voice @chans 32)\n// in1 voice id to fire (matches mc_channel -> this instance starts a grain)\n// in2 start (samples) | in3 pitch | in4 size (samples) | in5 pan | in6 amp\n// in7 env shape (live; both windows are 0 at the ends)\n// out1 grain audio | out2 latched pan (0-1) for mc.mixdown~ right inlet\n// All per-grain values are latched at onset; nothing touches a grain in flight.\n\nHistory cnt(0);\n\nBuffer buf(\"granular_buf\");\n\nid_diff = in1 - mc_channel;\nfire = id_diff > -0.5 && id_diff < 0.5;\n\ng_start = latch(in2, fire);\ng_pitch = latch(in3, fire);\ng_size = max(latch(in4, fire), 64);\ng_pan = latch(in5, fire);\ng_amp = latch(in6, fire);\n\nc = cnt + 1;\nif (fire) {\n    c = 0;\n}\ncnt = min(c, 1000000000);\n\ng_phase = c / g_size;\nvoice_audio = 0;\n\nif (g_phase < 1) {\n    env_hann = 0.5 - 0.5 * cos(g_phase * TWOPI);\n    env_tri = triangle(g_phase, 0.5);\n    env_val = mix(env_hann, env_tri, in7);\n\n    // Buffer read with linear interpolation (peek itself truncates)\n    last_frame = max(dim(buf) - 1, 0);\n    read_pos = clamp(g_start + c * g_pitch, 0, last_frame);\n    idx0 = floor(read_pos);\n    idx1 = min(idx0 + 1, last_frame);\n    frac = read_pos - idx0;\n    s0 = peek(buf, idx0, 0);\n    s1 = peek(buf, idx1, 0);\n    voice_audio = (s0 + (s1 - s0) * frac) * env_val * g_amp;\n}\n\nout1 = voice_audio;\nout2 = g_pan;",
          "numinlets": 7,
          "numoutlets": 2,
          "outlettype": [
            "",
            ""
          ],
          "patching_rect": [
            50.0,
            80.0,
            400.0,
            200.0
          ],
          "fontname": "Arial",
          "fontsize": 12.0
        }
      },
