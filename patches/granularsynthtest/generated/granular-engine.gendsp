    "boxes": [
      {
        "box": {
          "maxclass": "codebox",
          "id": "obj-1",
          "code": "// Granular Synthesis Engine\n// 32 voices, single master scheduler, stereo output\n// grain_size = envelope duration only\n// density = trigger rate only (grains/sec)\n// pitch = buffer read speed only\n// A grain starts only on an idle voice (never retriggers a sounding one);\n// when all 32 are busy the grain is dropped instead of truncating another.\n// position / pitch / size / pan are latched per grain at onset.\n\nParam grain_size(100, min=10, max=500);\nParam density(10, min=1, max=100);\nParam position(0.5, min=0, max=1);\nParam pitch(1, min=0.25, max=4);\nParam pos_jitter(0.1, min=0, max=1);\nParam pitch_jitter(0, min=0, max=1);\nParam size_jitter(0, min=0, max=1);\nParam pan_spread(0.5, min=0, max=1);\nParam env_shape(0, min=0, max=1);\n\nHistory one(1);\nHistory sched_phase(1);\n\nBuffer buf(\"granular_buf\");\n\nData voice_act(32);\nData voice_cnt(32);\nData voice_start(32);\nData voice_pitch(32);\nData voice_size(32);\nData voice_gl(32);\nData voice_gr(32);\n\n// De-hoist: route every Param through runtime state so gen~ keeps\n// these in the per-sample body (hoisted temps can be emitted out of order)\nsrs = samplerate * one;\nk_size = grain_size * one;\nk_density = density * one;\nk_pos = position * one;\nk_pitch = pitch * one;\nk_pos_jit = pos_jitter * one;\nk_pitch_jit = pitch_jitter * one;\nk_size_jit = size_jitter * one;\nk_pan = pan_spread * one;\nk_shape = env_shape * one;\n\nbuf_frames = dim(buf);\nlast_frame = max(buf_frames - 1, 0);\n\n// Master scheduler: one trigger per 1/density seconds\ntrig = 0;\nsp = sched_phase + k_density / srs;\nif (sp >= 1) {\n    sp = sp - floor(sp);\n    trig = 1;\n}\nsched_phase = sp;\n\nsum_l = 0;\nsum_r = 0;\n\nfor (v = 0; v < 32; v += 1) {\n    act = peek(voice_act, v, 0);\n    cnt = peek(voice_cnt, v, 0) + 1;\n\n    // Grain onset: claim the first idle voice, latch all per-grain values\n    if (trig > 0.5 && act < 0.5) {\n        rpos = noise();\n        rpitch = noise();\n        rsize = noise();\n        rpan = noise();\n\n        n_pitch = k_pitch * (1 + rpitch * k_pitch_jit);\n        n_size = max(k_size * (1 + rsize * k_size_jit) * srs * 0.001, 64);\n\n        // Clamp start position so the grain never reads past buffer end\n        read_len = n_size * n_pitch;\n        max_pos = clamp(buf_frames - read_len, 0, buf_frames) / max(buf_frames, 1);\n        n_start = clamp(k_pos + rpos * k_pos_jit, 0, max_pos) * buf_frames;\n\n        // Equal-power pan, scaled by expected overlap (incoherent sum)\n        pan_val = clamp(0.5 + rpan * k_pan * 0.5, 0, 1);\n        amp = 1 / sqrt(clamp(k_size * k_density * 0.001, 1, 32));\n\n        poke(voice_pitch, n_pitch, v, 0);\n        poke(voice_size, n_size, v, 0);\n        poke(voice_start, n_start, v, 0);\n        poke(voice_gl, sqrt(1 - pan_val) * amp, v, 0);\n        poke(voice_gr, sqrt(pan_val) * amp, v, 0);\n\n        act = 1;\n        cnt = 0;\n        trig = 0;\n    }\n\n    if (act > 0.5) {\n        g_size = max(peek(voice_size, v, 0), 64);\n        g_phase = cnt / g_size;\n        alive = g_phase < 1;\n\n        env_hann = 0.5 - 0.5 * cos(g_phase * TWOPI);\n        env_tri = triangle(g_phase, 0.5);\n        env_val = mix(env_hann, env_tri, k_shape) * alive;\n\n        // Buffer read with linear interpolation (peek itself truncates)\n        read_pos = peek(voice_start, v, 0) + cnt * peek(voice_pitch, v, 0);\n        read_pos = clamp(read_pos, 0, last_frame);\n        idx0 = floor(read_pos);\n        idx1 = min(idx0 + 1, last_frame);\n        frac = read_pos - idx0;\n        s0 = peek(buf, idx0, 0);\n        s1 = peek(buf, idx1, 0);\n        voice_audio = (s0 + (s1 - s0) * frac) * env_val;\n\n        sum_l += voice_audio * peek(voice_gl, v, 0);\n        sum_r += voice_audio * peek(voice_gr, v, 0);\n\n        act = alive;\n    }\n\n    poke(voice_act, act, v, 0);\n    poke(voice_cnt, cnt, v, 0);\n}\n\nout1 = sum_l;\nout2 = sum_r;",
          "numinlets": 0,
          "numoutlets": 2,
          "outlettype": [
