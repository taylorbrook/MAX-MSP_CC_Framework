      },
      {
        "box": {
          "maxclass": "codebox",
          "id": "obj-3",
          "code": "\n// Bassoon physical model\n// Scavone conical waveguide plus McIntyre/Woodhouse reed lookup\n// Inputs  in1 = freq Hz, in2 = breath pressure 0..1\n// Output  out1 = audio\n\n// ==========================================================\n// Declarations\n// ==========================================================\nParam reed_stiff(0.5, min=0, max=1);\nParam reed_aper(0.0, min=-1, max=1);\nParam bell_bright(0.5, min=0, max=1);\nParam vib_rate(5.0, min=0.1, max=12);\nParam vib_depth(0.0, min=0, max=50);\n\nHistory ap_x_prev(0);\nHistory ap_y_prev(0);\nHistory bell_y_prev(0);\nHistory cone_diff_prev(0);\nHistory cone_int_state(0);\nHistory vib_phase(0);\nHistory bore_wi(0);\n\nData bore(8192);\nData reed_lut(1024);\nData init_flag(1);\n\n\n// ==========================================================\n// Init once on first sample: build reed pressure-flow table\n// McIntyre and Woodhouse pressure-flow curve for a double reed\n//   flow = dp * sqrt(max(1 - sqr(dp/dp_close), 0))\n// dp is pressure drop across the reed\n// dp_close is where the reed slaps shut\n// Double reed threshold is tighter than a clarinet single reed\n// ==========================================================\nif (peek(init_flag, 0, 0) < 0.5) {\n    dp_close = 0.85;\n    for (i = 0; i < 1024; i += 1) {\n        x = i / 1023.0 * 2.0 - 1.0;\n        ax = abs(x);\n        ratio_sq = ax / dp_close * ax / dp_close;\n        opening = max(1.0 - ratio_sq, 0.0);\n        flow_v = x * sqrt(opening);\n        poke(reed_lut, flow_v, i, 0);\n    }\n    poke(init_flag, 1, 0, 0);\n}\n\n\n// ==========================================================\n// Internal vibrato LFO\n// freq_mod = freq * 2^(vib_sin * vib_depth_cents / 1200)\n// ==========================================================\nvib_inc = TWOPI * vib_rate / samplerate;\nvib_phase = vib_phase + vib_inc;\nif (vib_phase > TWOPI) { vib_phase = vib_phase - TWOPI; }\nvib_sin = sin(vib_phase);\ncents_offset = vib_sin * vib_depth;\nfreq_safe = max(in1, 20.0);\nfreq_mod = freq_safe * pow(2.0, cents_offset / 1200.0);\n\n\n// ==========================================================\n// D4 analytic phase-delay compensation\n// Two filters contribute phase delay in the loop\n//   onepole bell LPF    y = y_prev + a*(x - y_prev)\n//      transfer         H_z = a / (1 - (1-a)*z^-1)\n//      phase delay      atan((1-a)*sinw / (1 - (1-a)*cosw)) / w   samples\n//   allpass interp      phase delay ~ frac samples\n// We subtract both from period = SR/freq so the integer read\n// index locks to true target tuning.  This is the microtonal-\n// accuracy mechanism.\n// ==========================================================\nw = TWOPI * freq_mod / samplerate;\n\nbell_fc = 500.0 + bell_bright * 7500.0;\nbell_a = 1.0 - exp(-TWOPI * bell_fc / samplerate);\nb = 1.0 - bell_a;\nbell_phase_den = 1.0 - b * cos(w);\nbell_phase_num = b * sin(w);\nbell_pd_samples = atan(bell_phase_num / bell_phase_den) / max(w, 0.0001);\n\nperiod = samplerate / freq_mod;\nadjusted = period - bell_pd_samples;\nadjusted = max(adjusted, 4.0);\nadjusted = min(adjusted, 8190.0);\n\nint_part = floor(adjusted);\nfrac = adjusted - int_part;\neta = (1.0 - frac) / (1.0 + frac);\n\n\n// ==========================================================\n// Bore read\n// Integer tap then first-order allpass interpolation\n//   y_ap = eta*x + x_prev - eta*y_prev\n// ==========================================================\nwi = bore_wi;\nri = wi - int_part;\nif (ri < 0) { ri = ri + 8192; }\nx_int = peek(bore, ri, 0);\n\nbore_return = eta * x_int + ap_x_prev - eta * ap_y_prev;\nap_x_prev = x_int;\nap_y_prev = bore_return;\n\n\n// ==========================================================\n// Bell lowpass - radiation loss at the open end\n// ==========================================================\nbell_out = bell_y_prev + bell_a * (bore_return - bell_y_prev);\nbell_y_prev = bell_out;\n\n\n// ==========================================================\n// Cone truncation filter - Scavone and Smith apex model\n// Differentiator 1-z^-1 plus leaky integrator pole ~ 0.995\n// Together these approximate the apex reflection of a\n// truncated cone and yield odd+even harmonics characteristic\n// of the bassoon, versus the clarinet odd-only inversion.\n// ==========================================================\ncone_pole = 0.995;\ncone_diff = bell_out - cone_diff_prev;\ncone_diff_prev = bell_out;\ncone_int_state = cone_diff + cone_pole * cone_int_state;\n\ncone_return = -(cone_diff + cone_int_state * 0.002);\ncone_return = clamp(cone_return, -1.5, 1.5);\n\n\n// ==========================================================\n// Reed model - pressure-flow lookup\n// LUT index from breath minus bore pressure plus aperture bias\n// Stiffness attenuates flow - stiffer reed is harder to blow\n// ==========================================================\nbreath = clamp(in2, 0.0, 1.0);\ndelta_p = clamp(breath - cone_return + reed_aper, -1.0, 1.0);\n\nidx = (delta_p + 1.0) * 0.5 * 1023.0;\ni_lo = floor(idx);\ni_hi = min(i_lo + 1, 1023);\nlut_frac = idx - i_lo;\nv_lo = peek(reed_lut, i_lo, 0);\nv_hi = peek(reed_lut, i_hi, 0);\nreed_flow = v_lo + (v_hi - v_lo) * lut_frac;\n\nstiff_gain = 1.0 - reed_stiff * 0.6;\nreed_sig = reed_flow * stiff_gain;\n\n\n// ==========================================================\n// Bore injection\n// Mix reed excitation with reflected cone pressure\n// then write into the delay line and advance write pointer\n// ==========================================================\nbore_in = reed_sig + cone_return;\nbore_in = clamp(bore_in, -2.0, 2.0);\npoke(bore, bore_in, wi, 0);\n\nbore_wi = wi + 1;\nif (bore_wi >= 8192) { bore_wi = 0; }\n\n\n// ==========================================================\n// Output - bell-filtered return  the radiated tone\n// ==========================================================\nout1 = bell_out;\n",
          "numinlets": 2,
          "numoutlets": 1,
          "outlettype": [
            ""
          ],
          "patching_rect": [
            50.0,
            80.0,
            400.0,
            200.0
