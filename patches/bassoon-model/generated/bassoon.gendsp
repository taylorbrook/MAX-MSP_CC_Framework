      },
      {
        "box": {
          "maxclass": "codebox",
          "id": "obj-3",
          "code": "\n// Bassoon physical model (Scavone conical waveguide + McIntyre/Woodhouse reed)\n// Signal inputs: in1=freq (Hz), in2=breath pressure (0..1)\n// Single audio output on out1.\n\n// ==========================================================\n// DECLARATIONS (must precede all expressions)\n// ==========================================================\nParam reed_stiff(0.5, min=0, max=1);\nParam reed_aper(0.0, min=-1, max=1);\nParam bell_bright(0.5, min=0, max=1);\nParam vib_rate(5.0, min=0.1, max=12);\nParam vib_depth(0.0, min=0, max=50);\n\n// Allpass fractional delay state (1st-order): y = eta*x + x_prev - eta*y_prev\nHistory ap_x_prev(0);\nHistory ap_y_prev(0);\n\n// Bell lowpass state (onepole: y = y_prev + a*(x - y_prev))\nHistory bell_y_prev(0);\n\n// Cone truncation filter states (Scavone/Smith cone model):\n// differentiator + leaky integrator pair at the apex\nHistory cone_diff_prev(0);\nHistory cone_int_state(0);\n\n// Vibrato phase accumulator (radians)\nHistory vib_phase(0);\n\n// Circular bore write pointer\nHistory bore_wi(0);\n\n// Delay line (bore) -- 8192 samples, >= 4 periods at 20 Hz / 48 kHz\nData bore(8192);\n\n// Reed pressure-flow LUT (McIntyre/Woodhouse)\nData reed_lut(1024);\n\n// Init-once flag (pattern from project codebase)\nData init_flag(1);\n\n\n// ==========================================================\n// INITIALIZATION (runs once on first sample)\n// McIntyre/Woodhouse pressure-flow curve for a double reed:\n//   flow = dp * sqrt(max(1 - (dp/dp_close)^2, 0))\n// where dp is pressure-drop across reed and dp_close is the\n// pressure at which the reed slaps shut. Saturates (goes to 0)\n// beyond dp_close; for double-reed this boundary is tighter\n// than clarinet's single reed.\n// ==========================================================\nif (peek(init_flag, 0, 0) < 0.5) {\n    dp_close = 0.85;\n    for (i = 0; i < 1024; i += 1) {\n        x = (i / 1023.0) * 2.0 - 1.0;           // map 0..1023 -> -1..+1\n        ax = abs(x);\n        ratio_sq = (ax / dp_close) * (ax / dp_close);\n        opening = max(1.0 - ratio_sq, 0.0);\n        flow = x * sqrt(opening);               // signed, odd-symmetric\n        poke(reed_lut, flow, i, 0);\n    }\n    poke(init_flag, 1, 0, 0);\n}\n\n\n// ==========================================================\n// VIBRATO LFO (internal) -- modulates freq before delay calc\n// freq_mod = freq * 2^(vib_sin * vib_depth_cents / 1200)\n// ==========================================================\nvib_inc = TWOPI * vib_rate / samplerate;\nvib_phase = vib_phase + vib_inc;\nif (vib_phase > TWOPI) { vib_phase = vib_phase - TWOPI; }\nvib_sin = sin(vib_phase);\ncents_offset = vib_sin * vib_depth;\nfreq_safe = max(in1, 20.0);\nfreq_mod = freq_safe * pow(2.0, cents_offset / 1200.0);\n\n\n// ==========================================================\n// D4 -- ANALYTIC PHASE-DELAY COMPENSATION\n// Two filters sit in the loop and each contribute phase delay:\n//   (1) onepole bell LPF:  H(z) = a / (1 - (1-a) z^-1)\n//       phase delay at w = atan((1-a) sin w / (1 - (1-a) cos w)) / w  [samples]\n//   (2) allpass interpolator: phase delay ~= d (the fractional part)\n// We subtract both from the nominal period (SR/freq) so the integer\n// read index lands on the true target tuning, not the filter-shifted\n// one. This is the microtonal-accuracy mechanism.\n// ==========================================================\nw = TWOPI * freq_mod / samplerate;\n\nbell_fc = 500.0 + bell_bright * 7500.0;         // cutoff 500..8000 Hz\nbell_a = 1.0 - exp(-TWOPI * bell_fc / samplerate);\nb = 1.0 - bell_a;\nbell_phase_den = 1.0 - b * cos(w);\nbell_phase_num = b * sin(w);\nbell_pd_samples = atan(bell_phase_num / bell_phase_den) / max(w, 0.0001);\n\nperiod = samplerate / freq_mod;\nadjusted = period - bell_pd_samples;\n// Clamp so the allpass stays stable (need d in [0,1])\nadjusted = max(adjusted, 4.0);\nadjusted = min(adjusted, 8190.0);\n\nint_part = floor(adjusted);\nfrac = adjusted - int_part;\n// Subtract the allpass phase delay contribution (~= frac) from integer part\n// by absorbing into eta: eta built from frac directly.\neta = (1.0 - frac) / (1.0 + frac);\n\n\n// ==========================================================\n// BORE READ (fractional delay via 1st-order allpass)\n// Integer tap first, then allpass interpolation.\n// ==========================================================\nwi = bore_wi;\nri = wi - int_part;\nif (ri < 0) { ri = ri + 8192; }\nx_int = peek(bore, ri, 0);\n\nbore_return = eta * x_int + ap_x_prev - eta * ap_y_prev;\nap_x_prev = x_int;\nap_y_prev = bore_return;\n\n\n// ==========================================================\n// BELL LOWPASS (radiation loss at the open end)\n// ==========================================================\nbell_out = bell_y_prev + bell_a * (bore_return - bell_y_prev);\nbell_y_prev = bell_out;\n\n\n// ==========================================================\n// CONE TRUNCATION FILTER (Scavone/Smith cone model)\n// Differentiator (1 - z^-1) + leaky integrator (pole ~0.995)\n// Together these model the apex reflection of a truncated\n// cone, yielding odd+even harmonics (bassoon character)\n// versus the clarinet's odd-only from a simple inversion.\n// ==========================================================\ncone_pole = 0.995;\ncone_diff = bell_out - cone_diff_prev;\ncone_diff_prev = bell_out;\ncone_int_state = cone_diff + cone_pole * cone_int_state;\n\n// Cone return: sign-flipped (reed end) sum of the two paths.\n// Integrator is heavily attenuated to prevent DC drift / runaway.\ncone_return = -(cone_diff + cone_int_state * 0.002);\ncone_return = clamp(cone_return, -1.5, 1.5);\n\n\n// ==========================================================\n// REED MODEL (McIntyre/Woodhouse LUT lookup)\n// Index = breath - bore_return + aperture bias\n// Stiffness scales returned flow (stiffer => less flow)\n// ==========================================================\nbreath = clamp(in2, 0.0, 1.0);\ndelta_p = clamp(breath - cone_return + reed_aper, -1.0, 1.0);\n\nidx = (delta_p + 1.0) * 0.5 * 1023.0;\ni_lo = floor(idx);\ni_hi = min(i_lo + 1, 1023);\nlut_frac = idx - i_lo;\nv_lo = peek(reed_lut, i_lo, 0);\nv_hi = peek(reed_lut, i_hi, 0);\nreed_flow = v_lo + (v_hi - v_lo) * lut_frac;\n\n// Stiffer reed -> less flow (harder to blow); stiff=0 easy, stiff=1 hard\nstiff_gain = 1.0 - reed_stiff * 0.6;\nreed_sig = reed_flow * stiff_gain;\n\n\n// ==========================================================\n// BORE INJECTION\n// The new delay-line input is the reed excitation mixed with\n// the reflected cone pressure (sign re-flipped here to match\n// waveguide convention).\n// ==========================================================\nbore_in = reed_sig + cone_return;\nbore_in = clamp(bore_in, -2.0, 2.0);\npoke(bore, bore_in, wi, 0);\n\nbore_wi = wi + 1;\nif (bore_wi >= 8192) { bore_wi = 0; }\n\n\n// ==========================================================\n// OUTPUT: bell-filtered return (the radiated bassoon tone)\n// ==========================================================\nout1 = bell_out;\n",
          "numinlets": 2,
          "numoutlets": 1,
          "outlettype": [
            ""
          ],
