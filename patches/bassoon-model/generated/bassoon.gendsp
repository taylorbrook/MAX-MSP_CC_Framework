      {
        "box": {
          "maxclass": "codebox",
          "id": "obj-3",
          "code": "\n// Bassoon physical model v0.4\n// Scavone conical waveguide + rectified McIntyre/Woodhouse reed\n// Inputs:  in1 = freq Hz, in2 = breath pressure 0..1 (smoothed internally)\n// Output:  out1 = audio\n\n// ==========================================================\n// Declarations (all must precede any expressions)\n// ==========================================================\nParam reed_stiff(0.5, min=0, max=1);\nParam reed_aper(0.0, min=-1, max=1);\nParam bell_bright(0.5, min=0, max=1);\nParam vib_rate(5.0, min=0.1, max=12);\nParam vib_depth(0.0, min=0, max=50);\nParam bore_damp(0.3, min=0, max=1);\n\nHistory ap_x_prev(0);\nHistory ap_y_prev(0);\nHistory bell_x1(0);\nHistory bell_x2(0);\nHistory bell_y1(0);\nHistory bell_y2(0);\nHistory cone_dc(0);\nHistory bore_lp(0);\nHistory vib_phase(0);\nHistory bore_wi(0);\nHistory breath_state(0);\n\nData bore(8192);\nData reed_lut(1024);\nData init_flag(1);\n\n\n// ==========================================================\n// Init once: rectified double-reed pressure-flow table\n//   flow = x * sqrt(max(1 - (x/dp_close)^2, 0))\n// ==========================================================\nif (peek(init_flag, 0, 0) < 0.5) {\n    dp_close = 0.85;\n    for (i = 0; i < 1024; i += 1) {\n        x = i / 1023.0;\n        ratio_sq = x / dp_close * x / dp_close;\n        opening = max(1.0 - ratio_sq, 0.0);\n        flow_v = x * sqrt(opening);\n        poke(reed_lut, flow_v, i, 0);\n    }\n    poke(init_flag, 1, 0, 0);\n}\n\n\n// ==========================================================\n// Breath smoothing -- 20ms onepole LPF, replaces host line~\n// ==========================================================\nbreath_tau = 0.020;\nbreath_a = 1.0 - exp(-1.0 / (samplerate * breath_tau));\nbreath_in = clamp(in2, 0.0, 1.0);\nbreath_state = breath_state + breath_a * (breath_in - breath_state);\nbreath = breath_state;\n\n\n// ==========================================================\n// Internal vibrato LFO\n//   freq_mod = freq * 2^(vib_sin * vib_depth_cents / 1200)\n// ==========================================================\nvib_inc = TWOPI * vib_rate / samplerate;\nvib_phase = vib_phase + vib_inc;\nif (vib_phase > TWOPI) { vib_phase = vib_phase - TWOPI; }\nvib_sin = sin(vib_phase);\ncents_offset = vib_sin * vib_depth;\nfreq_safe = max(in1, 20.0);\nfreq_mod = freq_safe * pow(2.0, cents_offset / 1200.0);\n\n\n// ==========================================================\n// Bell radiation filter -- RBJ 2nd-order LPF biquad\n// Repurposes bell_bright (0..1) as a formant morph:\n//   bell_bright = 0  ->  fc=500 Hz,  Q=2.5  (dark, narrow formant @500)\n//   bell_bright = 1  ->  fc=2200 Hz, Q=0.7  (bright, flatter radiation)\n// Models bassoon tonehole-lattice radiation: ~500 Hz formant peak with\n// sharp rolloff above ~2200 Hz at the dark end; near-flat response at\n// the bright end.  Coefficients recomputed per sample from\n// bell_bright + samplerate (cheap, branch-free).\n// DEPRECATED: 'bell_a' (old onepole coefficient) kept as a 0.0 stub\n// for historical compatibility -- no longer used.\n// ==========================================================\nbell_fc = 500.0 + bell_bright * 1700.0;\nbell_q  = 2.5 - bell_bright * 1.8;\nbell_q  = max(bell_q, 0.2);\n\nwc     = TWOPI * bell_fc / samplerate;\ncos_wc = cos(wc);\nsin_wc = sin(wc);\nalpha_bq = sin_wc / (2.0 * bell_q);\n\nb0u = (1.0 - cos_wc) * 0.5;\nb1u = 1.0 - cos_wc;\nb2u = (1.0 - cos_wc) * 0.5;\na0u = 1.0 + alpha_bq;\na1u = -2.0 * cos_wc;\na2u = 1.0 - alpha_bq;\n\ninv_a0 = 1.0 / a0u;\nb0 = b0u * inv_a0;\nb1 = b1u * inv_a0;\nb2 = b2u * inv_a0;\na1 = a1u * inv_a0;\na2 = a2u * inv_a0;\n\nbell_a = 0.0;  // deprecated: former onepole coefficient (unused)\n\n\n// ==========================================================\n// D4 analytic phase-delay compensation\n// Biquad group delay at freq_mod via\n//   tau_P(w) = Re{ sum(k * p_k * e^-jwk) / P(e^jw) }.\n// Evaluate numerator (b0,b1,b2) and denominator (1,a1,a2) separately;\n// total group delay = tau_B - tau_A.  Plus bore-damp onepole phase\n// delay (unchanged from v0.3.1).  Both subtracted from the round-trip\n// period so pitch tracks freq_mod while bell_bright and bore_damp\n// sweep.\n// ==========================================================\nw   = TWOPI * freq_mod / samplerate;\ncw  = cos(w);\nsw  = sin(w);\nc2w = cos(2.0 * w);\ns2w = sin(2.0 * w);\n\n// Numerator B(z) = b0 + b1 z^-1 + b2 z^-2\n//   derivative sum   b1 e^-jw + 2 b2 e^-2jw\n//   polynomial sum   b0 + b1 e^-jw + b2 e^-2jw\ndB_re = b1 * cw + 2.0 * b2 * c2w;\ndB_im = -(b1 * sw + 2.0 * b2 * s2w);\nPB_re = b0 + b1 * cw + b2 * c2w;\nPB_im = -(b1 * sw + b2 * s2w);\nPB_mag = PB_re * PB_re + PB_im * PB_im;\nPB_mag = max(PB_mag, 1e-12);\ntau_B = (dB_re * PB_re + dB_im * PB_im) / PB_mag;\n\n// Denominator A(z) = 1 + a1 z^-1 + a2 z^-2\ndA_re = a1 * cw + 2.0 * a2 * c2w;\ndA_im = -(a1 * sw + 2.0 * a2 * s2w);\nPA_re = 1.0 + a1 * cw + a2 * c2w;\nPA_im = -(a1 * sw + a2 * s2w);\nPA_mag = PA_re * PA_re + PA_im * PA_im;\nPA_mag = max(PA_mag, 1e-12);\ntau_A = (dA_re * PA_re + dA_im * PA_im) / PA_mag;\n\nbell_gd_samples = tau_B - tau_A;\nbell_gd_samples = max(bell_gd_samples, 0.0);\nbell_gd_samples = min(bell_gd_samples, 32.0);\n\n// Bore-damp onepole phase delay (reflection-path LPF, unchanged).\n// Coefficients computed here so the reflection step below can reuse\n// them without recompute.\nbore_fc = 1000.0 + bore_damp * 7000.0;\nbore_a  = 1.0 - exp(-TWOPI * bore_fc / samplerate);\nbore_b  = 1.0 - bore_a;\nbore_pd_den = 1.0 - bore_b * cos(w);\nbore_pd_num = bore_b * sin(w);\nbore_pd_samples = atan(bore_pd_num / bore_pd_den) / max(w, 0.0001);\n\nperiod = samplerate / freq_mod;\nadjusted = period - bell_gd_samples - bore_pd_samples;\nadjusted = max(adjusted, 4.0);\nadjusted = min(adjusted, 8190.0);\n\nint_part = floor(adjusted);\nfrac = adjusted - int_part;\neta = (1.0 - frac) / (1.0 + frac);\n\n\n// ==========================================================\n// Bore read: integer tap + first-order allpass\n// ==========================================================\nwi = bore_wi;\nri = wi - int_part;\nif (ri < 0) { ri = ri + 8192; }\nx_int = peek(bore, ri, 0);\n\nbore_return = eta * x_int + ap_x_prev - eta * ap_y_prev;\nap_x_prev = x_int;\nap_y_prev = bore_return;\n\n\n// ==========================================================\n// Bell biquad step -- Direct Form I\n//   y[n] = b0*x + b1*x1 + b2*x2 - a1*y1 - a2*y2\n// ==========================================================\nbell_in  = bore_return;\nbell_out = b0 * bell_in\n         + b1 * bell_x1\n         + b2 * bell_x2\n         - a1 * bell_y1\n         - a2 * bell_y2;\nbell_x2 = bell_x1;\nbell_x1 = bell_in;\nbell_y2 = bell_y1;\nbell_y1 = bell_out;\n\n\n// ==========================================================\n// Cone apex reflection -- DC-blocked, inverted, lossy.\n// cone_alpha = 0.001 -> DC corner ~7Hz at 44.1k.\n// cone_loss  < 1     -> dissipates per round trip, guarantees stability.\n// ==========================================================\ncone_alpha = 0.001;\ncone_loss  = 0.85;\ncone_dc = cone_dc + cone_alpha * (bell_out - cone_dc);\ncone_hp = bell_out - cone_dc;\n\n// Bore damping -- onepole LPF in reflection path.  bore_a computed\n// in the D4 block so its phase delay is compensated.\n//   bore_damp = 0 -> fc ~1 kHz (dark, heavy HF loss)\n//   bore_damp = 1 -> fc ~8 kHz (bright, near-flat loss)\nbore_lp = bore_lp + bore_a * (cone_hp - bore_lp);\n\ncone_return = -bore_lp * cone_loss;\ncone_return = clamp(cone_return, -1.5, 1.5);\n\n\n// ==========================================================\n// Reed model -- rectified pressure-flow lookup\n// delta_p > 0 only; below zero reed slams shut and flow = 0.\n// ==========================================================\ndelta_p = breath - cone_return + reed_aper;\ndelta_p = max(delta_p, 0.0);\ndelta_p = min(delta_p, 1.0);\n\nidx = delta_p * 1023.0;\ni_lo = floor(idx);\ni_hi = min(i_lo + 1, 1023);\nlut_frac = idx - i_lo;\nv_lo = peek(reed_lut, i_lo, 0);\nv_hi = peek(reed_lut, i_hi, 0);\nreed_flow = v_lo + (v_hi - v_lo) * lut_frac;\n\nstiff_gain = 1.0 - reed_stiff * 0.6;\nreed_sig = reed_flow * stiff_gain;\n\n\n// ==========================================================\n// Bore injection\n// ==========================================================\nbore_in = reed_sig + cone_return;\nbore_in = clamp(bore_in, -2.0, 2.0);\npoke(bore, bore_in, wi, 0);\n\nbore_wi = wi + 1;\nif (bore_wi >= 8192) { bore_wi = 0; }\n\n\n// ==========================================================\n// Output -- bell-filtered return, the radiated tone\n// ==========================================================\nout1 = bell_out;\n",
          "numinlets": 2,
          "numoutlets": 1,
          "outlettype": [
            ""
          ],
          "patching_rect": [
            50.0,
            80.0,
            400.0,
            200.0
          ],
          "fontname": "Arial",
          "fontsize": 12.0
        }
