      },
      {
        "box": {
          "maxclass": "codebox",
          "id": "obj-3",
          "code": "\n// Bassoon physical model v0.2\n// Scavone conical waveguide + rectified McIntyre/Woodhouse reed\n// Inputs:  in1 = freq Hz, in2 = breath pressure 0..1 (smoothed internally)\n// Output:  out1 = audio\n\n// ==========================================================\n// Declarations (all must precede any expressions)\n// ==========================================================\nParam reed_stiff(0.5, min=0, max=1);\nParam reed_aper(0.0, min=-1, max=1);\nParam bell_bright(0.5, min=0, max=1);\nParam vib_rate(5.0, min=0.1, max=12);\nParam vib_depth(0.0, min=0, max=50);\n\nHistory ap_x_prev(0);\nHistory ap_y_prev(0);\nHistory bell_y_prev(0);\nHistory cone_dc(0);\nHistory vib_phase(0);\nHistory bore_wi(0);\nHistory breath_state(0);\n\nData bore(8192);\nData reed_lut(1024);\nData init_flag(1);\n\n\n// ==========================================================\n// Init once: rectified double-reed pressure-flow table\n// Positive delta_p only -- negative delta_p means the reed is\n// beating shut, so flow = 0.  Table index 0..1023 maps delta_p 0..1.\n//   flow = x * sqrt(max(1 - (x/dp_close)^2, 0))\n// ==========================================================\nif (peek(init_flag, 0, 0) < 0.5) {\n    dp_close = 0.85;\n    for (i = 0; i < 1024; i += 1) {\n        x = i / 1023.0;\n        ratio_sq = x / dp_close * x / dp_close;\n        opening = max(1.0 - ratio_sq, 0.0);\n        flow_v = x * sqrt(opening);\n        poke(reed_lut, flow_v, i, 0);\n    }\n    poke(init_flag, 1, 0, 0);\n}\n\n\n// ==========================================================\n// Breath smoothing (replaces host-side line~)\n// Onepole LPF, ~20ms time constant -- removes control-rate steps\n// from live.slider so the reed sees a continuous pressure ramp.\n// ==========================================================\nbreath_tau = 0.020;\nbreath_a = 1.0 - exp(-1.0 / (samplerate * breath_tau));\nbreath_in = clamp(in2, 0.0, 1.0);\nbreath_state = breath_state + breath_a * (breath_in - breath_state);\nbreath = breath_state;\n\n\n// ==========================================================\n// Internal vibrato LFO\n//   freq_mod = freq * 2^(vib_sin * vib_depth_cents / 1200)\n// ==========================================================\nvib_inc = TWOPI * vib_rate / samplerate;\nvib_phase = vib_phase + vib_inc;\nif (vib_phase > TWOPI) { vib_phase = vib_phase - TWOPI; }\nvib_sin = sin(vib_phase);\ncents_offset = vib_sin * vib_depth;\nfreq_safe = max(in1, 20.0);\nfreq_mod = freq_safe * pow(2.0, cents_offset / 1200.0);\n\n\n// ==========================================================\n// D4 analytic phase-delay compensation\n// Subtract onepole bell-filter phase delay from the target period.\n// ==========================================================\nw = TWOPI * freq_mod / samplerate;\n\nbell_fc = 500.0 + bell_bright * 7500.0;\nbell_a = 1.0 - exp(-TWOPI * bell_fc / samplerate);\nb = 1.0 - bell_a;\nbell_phase_den = 1.0 - b * cos(w);\nbell_phase_num = b * sin(w);\nbell_pd_samples = atan(bell_phase_num / bell_phase_den) / max(w, 0.0001);\n\nperiod = samplerate / freq_mod;\nadjusted = period - bell_pd_samples;\nadjusted = max(adjusted, 4.0);\nadjusted = min(adjusted, 8190.0);\n\nint_part = floor(adjusted);\nfrac = adjusted - int_part;\neta = (1.0 - frac) / (1.0 + frac);\n\n\n// ==========================================================\n// Bore read: integer tap + first-order allpass\n// ==========================================================\nwi = bore_wi;\nri = wi - int_part;\nif (ri < 0) { ri = ri + 8192; }\nx_int = peek(bore, ri, 0);\n\nbore_return = eta * x_int + ap_x_prev - eta * ap_y_prev;\nap_x_prev = x_int;\nap_y_prev = bore_return;\n\n\n// ==========================================================\n// Bell lowpass -- radiation loss at the open end\n// ==========================================================\nbell_out = bell_y_prev + bell_a * (bore_return - bell_y_prev);\nbell_y_prev = bell_out;\n\n\n// ==========================================================\n// Cone apex reflection -- DC-blocked, inverted, lossy\n// Previous version used a pure differentiator (unity HF gain)\n// plus a vestigial scaled integrator, so the bore loop self-\n// oscillated near Nyquist and output pitch did not track freq.\n//\n// New form:  slow DC tracker  cone_dc = cone_dc + alpha*(x - cone_dc)\n//            highpassed x    x_hp    = bell_out - cone_dc\n//            reflection      r       = -x_hp * cone_loss\n// cone_loss < 1 dissipates per round trip, guaranteeing stability.\n// alpha = 0.001 -> DC corner ~7Hz at 44.1k, enough to block drift.\n// ==========================================================\ncone_alpha = 0.001;\ncone_loss = 0.85;\ncone_dc = cone_dc + cone_alpha * (bell_out - cone_dc);\ncone_hp = bell_out - cone_dc;\ncone_return = -cone_hp * cone_loss;\ncone_return = clamp(cone_return, -1.5, 1.5);\n\n\n// ==========================================================\n// Reed model -- rectified pressure-flow lookup\n// delta_p > 0 only; below zero the reed slams shut and flow = 0.\n// Rectification eliminates the signed-flow positive feedback that\n// was reinforcing the unstable loop.\n// ==========================================================\ndelta_p = breath - cone_return + reed_aper;\ndelta_p = max(delta_p, 0.0);\ndelta_p = min(delta_p, 1.0);\n\nidx = delta_p * 1023.0;\ni_lo = floor(idx);\ni_hi = min(i_lo + 1, 1023);\nlut_frac = idx - i_lo;\nv_lo = peek(reed_lut, i_lo, 0);\nv_hi = peek(reed_lut, i_hi, 0);\nreed_flow = v_lo + (v_hi - v_lo) * lut_frac;\n\nstiff_gain = 1.0 - reed_stiff * 0.6;\nreed_sig = reed_flow * stiff_gain;\n\n\n// ==========================================================\n// Bore injection\n// ==========================================================\nbore_in = reed_sig + cone_return;\nbore_in = clamp(bore_in, -2.0, 2.0);\npoke(bore, bore_in, wi, 0);\n\nbore_wi = wi + 1;\nif (bore_wi >= 8192) { bore_wi = 0; }\n\n\n// ==========================================================\n// Output -- bell-filtered return, the radiated tone\n// ==========================================================\nout1 = bell_out;\n",
          "numinlets": 2,
          "numoutlets": 1,
          "outlettype": [
            ""
          ],
          "patching_rect": [
            50.0,
            80.0,
            400.0,
            200.0
