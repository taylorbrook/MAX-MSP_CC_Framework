      {
        "box": {
          "maxclass": "codebox",
          "id": "obj-3",
          "code": "\n// Bassoon physical model v0.9.0\n// Scavone conical waveguide + rectified McIntyre/Woodhouse reed\n// Bell biquad is a POST-LOOP radiation filter (not in the feedback path),\n// so bell_bright controls output timbre without detuning the bore.\n// v0.6.0: breath-turbulence noise (4 kHz LPF, gain-following chiff)\n//         injected into breath before the reed LUT -- noise_amt Param.\n// v0.7.0: tremolo -- reuse vib LFO to modulate breath amplitude +\n//         noise envelope via vib_amp Param (0..0.3, default 0.08).\n// v0.8.0: attack chiff -- rising-breath-edge envelope gates 6 kHz\n//         filtered noise into bore_in (chiff_amt Param, default 0.3).\n// v0.9.0: register control -- biases bore toward 2nd-mode behavior\n//         for upper-register playing.  register=0 -> v0.8.0 behavior;\n//         register=1 -> cone_return scaled by 0.7 (weaker fundamental\n//         support) AND effective bore_damp -> 0.6 (less HF loss,\n//         favors harmonics).  Linear interp between.  Intended for\n//         high notes; low notes may go unstable near register=1.\n// v0.10.2: reed_sig attenuated by 0.75 at the driver stage (early in\n//         the DSP chain, before bore injection) -- lowers overall\n//         output amplitude via the physical model rather than a\n//         post-hoc output multiplier.  Equivalent to slightly softer\n//         blowing pressure; preserves reed nonlinearity + timbre.\n// v0.11.0: vibrato realism pass -- adds (1) delayed onset envelope\n//          that ramps vibrato in ~300ms after ~150ms breath-onset\n//          delay and fades on release; (2) rate jitter (+-12% slow\n//          drift via cascaded LP-filtered noise, ~0.7 Hz); (3)\n//          pitch<->amp phase offset (tremolo lags pitch 0..90 deg\n//          via vib_amp_lag); (4) mild 2nd-harmonic waveshape\n//          (sin(x) + 0.08*sin(2x + pi/6)) for non-sinusoidal\n//          asymmetry.  Addresses the three biggest synthetic tells:\n//          instant full vibrato, metronomic rate, and in-phase\n//          AM/FM lockstep.\n// v0.12.0: kill reed_lut -- replaced 1024-point Data table +\n//          init_flag bootstrap + 2x peek + lerp with closed-form\n//          flow = x * sqrt(max(1 - (x/0.85)^2, 0)).  Drops ~60 lines,\n//          2 Data decls, and 2 mem reads per sample for equal cost.\n// v0.12.3: hoist runtime multipliers into Param calibration --\n//          fold 0.75 into stiff_gain curve (stiff_gain = 0.75 -\n//          reed_stiff*0.45) and narrow noise_amt to [0, 0.5]\n//          (default 0.075).  Saves 2 mults/sample; Param values\n//          now match the audible effect.  Presets migrated (half).\n// Inputs:  in1 = freq Hz, in2 = breath pressure 0..1 (smoothed internally)\n// Output:  out1 = biquad-filtered bore radiation\n\n// ==========================================================\n// Declarations (all must precede any expressions)\n// ==========================================================\nParam reed_stiff(0.5, min=0, max=1);\nParam reed_aper(0.0, min=-1, max=1);\nParam bell_bright(0.5, min=0, max=1);\nParam vib_rate(5.0, min=0.1, max=12);\nParam vib_depth(0.0, min=0, max=50);\nParam vib_amp(0.08, min=0, max=0.3);\nParam bore_damp(0.3, min=0, max=1);\nParam reed_res_freq(1500, min=500, max=2500);\nParam reed_res_q(2.5, min=1, max=6);\nParam noise_amt(0.075, min=0, max=0.5);\nParam chiff_amt(0.3, min=0, max=1);\nParam register(0, min=0, max=1);\nParam vib_onset_time(0.15, min=0, max=1);\nParam vib_ramp_time(0.3, min=0.05, max=1);\nParam vib_rate_jit(0.12, min=0, max=0.3);\nParam vib_amp_lag(0.5, min=0, max=1);\n\nHistory ap_x_prev(0);\nHistory ap_y_prev(0);\nHistory bell_x1(0);\nHistory bell_x2(0);\nHistory bell_y1(0);\nHistory bell_y2(0);\nHistory cone_dc(0);\nHistory bore_lp(0);\nHistory vib_phase(0);\nHistory bore_wi(0);\nHistory breath_state(0);\nHistory reed_bp_v1(0);\nHistory reed_bp_v2(0);\nHistory noise_lp(0);\nHistory breath_prev_for_chiff(0);\nHistory chiff_env(0);\nHistory chiff_lp(0);\nHistory vib_env(0);\nHistory onset_timer(0);\nHistory jit_state1(0);\nHistory jit_state2(0);\n\nData bore(8192);\n\n\n// ==========================================================\n// Internal vibrato LFO (v0.11) -- onset envelope, rate jitter,\n// non-sine waveshape, and phase-offset AM.\n//\n// Pipeline:\n//   onset detect  -> vib_env (0->1 ramp after breath on, fades on release)\n//   noise LFO     -> rate_jit (+-12% slow drift)\n//   vib_rate*jit  -> vib_phase accumulator\n//   vib_phase     -> vib_sin (with mild 2nd harmonic) -> drives FM\n//   vib_phase-lag -> amp_sin (separate phase)         -> drives AM\n// vib_env multiplies BOTH depth and amp so both fade in/out together.\n// ==========================================================\n\n// --- Onset/release envelope (V1, V6) ---\n// Use raw in2 for onset detection so envelope leads the smoothed breath\n// slightly; threshold 0.05 rejects residual float noise.\nbreath_hot = (in2 > 0.05) ? 1.0 : 0.0;\nonset_timer = breath_hot * (onset_timer + 1.0);\nonset_sec = onset_timer / samplerate;\nvib_target = clamp((onset_sec - vib_onset_time) / max(vib_ramp_time, 0.01), 0.0, 1.0);\nvib_target = vib_target * breath_hot;\n// Asymmetric smoothing: 50ms attack, 150ms release\nenv_tau_atk = 0.050;\nenv_tau_rel = 0.150;\nenv_a_atk = 1.0 - exp(-1.0 / (samplerate * env_tau_atk));\nenv_a_rel = 1.0 - exp(-1.0 / (samplerate * env_tau_rel));\nenv_a = (vib_target > vib_env) ? env_a_atk : env_a_rel;\nvib_env = vib_env + env_a * (vib_target - vib_env);\n\n// --- Rate jitter (V2) ---\n// Two cascaded onepoles (~0.7 Hz) on white noise give slow smooth drift.\n// noise() is white +-1, so *3 is a rough scale factor -- final amplitude\n// is bounded by vib_rate_jit anyway.\njit_fc = 0.7;\njit_a  = 1.0 - exp(-TWOPI * jit_fc / samplerate);\njit_raw = noise();\njit_state1 = jit_state1 + jit_a * (jit_raw - jit_state1);\njit_state2 = jit_state2 + jit_a * (jit_state1 - jit_state2);\nrate_eff = vib_rate * (1.0 + vib_rate_jit * jit_state2 * 3.0);\nrate_eff = max(rate_eff, 0.01);\n\n// --- Phase accumulator ---\nvib_inc = TWOPI * rate_eff / samplerate;\nvib_phase = vib_phase + vib_inc;\nif (vib_phase > TWOPI) { vib_phase = vib_phase - TWOPI; }\n\n// --- Waveshape (V5): slight 2nd-harmonic asymmetry ---\nvib_sin = sin(vib_phase) + 0.08 * sin(2.0 * vib_phase + 0.524);\n\n// --- AM phase offset (V3): tremolo lags pitch up to pi/2 ---\namp_phase = vib_phase - 1.5708 * vib_amp_lag;\namp_sin = sin(amp_phase) + 0.08 * sin(2.0 * amp_phase + 0.524);\n\n\n// ==========================================================\n// Breath smoothing -- 20ms onepole LPF, replaces host line~\n// ==========================================================\nbreath_tau = 0.020;\nbreath_a = 1.0 - exp(-1.0 / (samplerate * breath_tau));\nbreath_in = clamp(in2, 0.0, 1.0);\nbreath_state = breath_state + breath_a * (breath_in - breath_state);\n\n\n// ==========================================================\n// Tremolo (v0.11) -- uses amp_sin (phase-offset from vib_sin) and\n// fades in/out with vib_env so AM follows the onset envelope.\n// ==========================================================\ntrem_gain = 1.0 + amp_sin * vib_amp * vib_env;\nbreath = breath_state * trem_gain;\n\n\n// ==========================================================\n// Breath turbulence noise -- gain-following filtered chiff\n// Filtered white noise (~4 kHz onepole LPF, pink-ish) scaled by\n// the tremolo-modulated breath envelope so silence stays silent,\n// the chiff follows the breath envelope, AND the noise level\n// wobbles with vibrato tremolo.  Models air-jet turbulence in the\n// confined double-reed embouchure channel.\n//   noise_amt = 0       -> identity (matches pre-noise behavior)\n//   noise_amt = 0.3-.6  -> subtle breathiness on sustained tones\n// v0.12.3: *0.5 audible-scale factor folded into Param range\n//          (max=0.5, default=0.075); runtime multiplier removed.\n// ==========================================================\nnoise_fc = 4000.0;\nnoise_a  = 1.0 - exp(-TWOPI * noise_fc / samplerate);\nnoise_raw = noise();\nnoise_lp  = noise_lp + noise_a * (noise_raw - noise_lp);\nnoise_env = breath;\nbreath = breath + noise_lp * noise_env * noise_amt;\n\n\n// ==========================================================\n// Attack transient (\"chiff\") -- detect rising breath edge,\n// envelope-follow the positive derivative, and inject a brief\n// burst of bright filtered noise into the bore.  Models the\n// turbulent burst as the player engages the reed before the\n// bore oscillation locks in.\n//   chiff_amt = 0    -> bypass cleanly (gain term = 0)\n//   chiff_amt = 0.3  -> noticeable \"ch\" on staccato attacks\n// Sustained tones generate no chiff: breath_d ~= 0 and the\n// envelope decays per-sample by 0.998 (~50ms tail @ 44.1k).\n// Uses post-tremolo, post-noise breath so envelope follows the\n// effective excitation pressure.\n// ==========================================================\nbreath_d = breath - breath_prev_for_chiff;\nbreath_prev_for_chiff = breath;\nif (breath_d > 0) {\n    new_env = breath_d * 30.0;\n    chiff_env = max(chiff_env, new_env);\n}\nchiff_env = chiff_env * 0.998;\n\n// Brighter (~6 kHz) onepole-filtered white noise -- gives the chiff\n// a sharper \"sh\" character than the 4 kHz sustained turbulence path.\nchiff_fc = 6000.0;\nchiff_a  = 1.0 - exp(-TWOPI * chiff_fc / samplerate);\nchiff_raw = noise();\nchiff_lp  = chiff_lp + chiff_a * (chiff_raw - chiff_lp);\nchiff_sig = chiff_lp * chiff_env * chiff_amt;\n\n\n// ==========================================================\n// Freq modulation from vibrato LFO (v0.11: depth * vib_env for\n// delayed-onset ramping; vib_env=0 -> no pitch mod until ramp in).\n//   freq_mod = freq * 2^(vib_sin * vib_depth * vib_env / 1200)\n// ==========================================================\ncents_offset = vib_sin * vib_depth * vib_env;\nfreq_safe = max(in1, 20.0);\nfreq_mod = freq_safe * pow(2.0, cents_offset / 1200.0);\n\n\n// ==========================================================\n// Bell radiation filter -- RBJ 2nd-order LPF biquad (POST-LOOP)\n// This filter shapes the radiated output; it is NOT in the bore\n// feedback path.  Putting a resonant filter inside the loop caused\n// the bore to lock onto the filter's resonance instead of freq_mod\n// (v0.4.0/0.4.1 regression).  Decoupling fixes tuning and still lets\n// bell_bright morph the radiation spectrum freely.\n//\n// bell_bright = 0  ->  fc=500 Hz,  Q=2.5  (dark/narrow formant @500)\n// bell_bright = 1  ->  fc=2200 Hz, Q=0.7  (bright/flatter radiation)\n// Models bassoon tonehole-lattice radiation: ~500 Hz formant peak with\n// sharp rolloff above ~2200 Hz at the dark end; near-flat at bright.\n// Coefficients recomputed per sample from bell_bright + samplerate.\n// ==========================================================\nbell_fc = 500.0 + bell_bright * 1700.0;\nbell_q  = 2.5 - bell_bright * 1.8;\nbell_q  = max(bell_q, 0.2);\n\nwc     = TWOPI * bell_fc / samplerate;\ncos_wc = cos(wc);\nsin_wc = sin(wc);\nalpha_bq = sin_wc / (2.0 * bell_q);\n\nb0u = (1.0 - cos_wc) * 0.5;\nb1u = 1.0 - cos_wc;\nb2u = (1.0 - cos_wc) * 0.5;\na0u = 1.0 + alpha_bq;\na1u = -2.0 * cos_wc;\na2u = 1.0 - alpha_bq;\n\ninv_a0 = 1.0 / a0u;\nb0 = b0u * inv_a0;\nb1 = b1u * inv_a0;\nb2 = b2u * inv_a0;\na1 = a1u * inv_a0;\na2 = a2u * inv_a0;\n\n\n// ==========================================================\n// D4 analytic phase-delay compensation\n// Bell biquad is out-of-loop, so it does NOT contribute to the loop\n// length.  Only the bore-damp onepole in the reflection path affects\n// tuning.\n// ==========================================================\nw = TWOPI * freq_mod / samplerate;\n\n// Register bias: at register=1, effective bore_damp -> 0.6 (less HF loss,\n// favors upper partials), enabling overblow to 2nd mode.\nbore_damp_eff = bore_damp * (1.0 - register) + 0.6 * register;\nbore_fc = 1000.0 + bore_damp_eff * 7000.0;\nbore_a  = 1.0 - exp(-TWOPI * bore_fc / samplerate);\nbore_b  = 1.0 - bore_a;\nbore_pd_den = 1.0 - bore_b * cos(w);\nbore_pd_num = bore_b * sin(w);\nbore_pd_samples = atan(bore_pd_num / bore_pd_den) / max(w, 0.0001);\n\nperiod = samplerate / freq_mod;\nadjusted = period - bore_pd_samples;\nadjusted = max(adjusted, 4.0);\nadjusted = min(adjusted, 8190.0);\n\nint_part = floor(adjusted);\nfrac = adjusted - int_part;\neta = (1.0 - frac) / (1.0 + frac);\n\n\n// ==========================================================\n// Bore read: integer tap + first-order allpass\n// ==========================================================\nwi = bore_wi;\nri = wi - int_part;\nif (ri < 0) { ri = ri + 8192; }\nx_int = peek(bore, ri, 0);\n\nbore_return = eta * x_int + ap_x_prev - eta * ap_y_prev;\nap_x_prev = x_int;\nap_y_prev = bore_return;\n\n\n// ==========================================================\n// Cone apex reflection -- DC-blocked, inverted, lossy.\n// No bell filter in the reflection path (moved to post-loop radiation).\n// cone_alpha = 0.001 -> DC corner ~7Hz at 44.1k.\n// cone_loss  < 1     -> dissipates per round trip, guarantees stability.\n// ==========================================================\ncone_alpha = 0.001;\ncone_loss  = 0.85;\ncone_dc = cone_dc + cone_alpha * (bore_return - cone_dc);\ncone_hp = bore_return - cone_dc;\n\n// Bore damping -- onepole LPF in reflection path (compensated via\n// bore_pd_samples above).  bore_damp=0 -> fc ~1 kHz (dark, heavy HF\n// loss); bore_damp=1 -> fc ~8 kHz (bright, near-flat loss).\nbore_lp = bore_lp + bore_a * (cone_hp - bore_lp);\n\n// Register bias: at register=1, scale reflection by 0.7 (weaker\n// fundamental support, easier overblow to 2nd mode).\nreg_refl_gain = 1.0 - register * 0.3;\ncone_return = -bore_lp * cone_loss * reg_refl_gain;\ncone_return = clamp(cone_return, -1.5, 1.5);\n\n\n// ==========================================================\n// Reed model -- rectified pressure-flow (closed-form)\n// delta_p > 0 only; below zero reed slams shut and flow = 0.\n// v0.12.0: replaced 1024-point LUT + init_flag + peek/lerp with\n// direct eval:  flow = x * sqrt(max(1 - (x/0.85)^2, 0))\n// gen~ constant-folds (1/0.85); cost is 1 sqrt + 3 muls/sample,\n// on par with the LUT path but drops 2 Data decls and 2 peeks.\n// ==========================================================\ndelta_p = breath - cone_return + reed_aper;\ndelta_p = max(delta_p, 0.0);\ndelta_p = min(delta_p, 1.0);\n\nreed_ratio = delta_p * (1.0 / 0.85);\nreed_opening = max(1.0 - reed_ratio * reed_ratio, 0.0);\nreed_flow = delta_p * sqrt(reed_opening);\n\n// v0.12.3: 0.75 driver attenuation folded into stiff_gain curve --\n// stiff_gain ranges [0.75, 0.30] as reed_stiff 0->1, identical to\n// the prior (1 - 0.6*stiff) * 0.75 product but drops one mult/sample.\nstiff_gain = 0.75 - reed_stiff * 0.45;\nreed_sig = reed_flow * stiff_gain;\n\n\n// ==========================================================\n// Reed resonance BPF -- RBJ bandpass biquad (DF2T, 2 state)\n// Constant skirt gain; peak gain = reed_res_q at resonance.\n// Models the short confined double-reed channel resonance.\n// Routed POST-LOOP (summed into bell biquad input) so it colors\n// the radiated output without participating in the waveguide\n// feedback.  Putting a Q>1 filter inside the bore loop would pull\n// the loop's oscillation frequency (same class of regression as\n// v0.4.0/0.4.1 bell-in-loop).\n// ==========================================================\nrw = TWOPI * reed_res_freq / samplerate;\nrsin = sin(rw);\nralpha = rsin / (2.0 * max(reed_res_q, 0.1));\nra0 = 1.0 + ralpha;\nr_inv_a0 = 1.0 / ra0;\n// Constant skirt gain, peak gain = Q at fc (RBJ form).\n// Previous form (b0=alpha) was constant 0 dB peak -- sweeping Q only\n// narrowed the passband without increasing resonance gain, making\n// the honk inaudible.  Now b0 = sin(w)/2 so peak = Q.\nrb0 = rsin * 0.5 * r_inv_a0;\nrb2 = -rb0;\nra1 = -2.0 * cos(rw) * r_inv_a0;\nra2 = (1.0 - ralpha) * r_inv_a0;\n\nreed_filt = rb0 * reed_sig + reed_bp_v1;\nreed_bp_v1 = reed_bp_v2 - ra1 * reed_filt;\nreed_bp_v2 = rb2 * reed_sig - ra2 * reed_filt;\n\n\n// ==========================================================\n// Bore injection\n//   reed_sig    -- driven oscillator (rectified pressure-flow)\n//   cone_return -- bore reflection from cone apex\n//   chiff_sig   -- transient noise burst on rising-breath edges\n// ==========================================================\nbore_in_s = reed_sig + cone_return + chiff_sig;\nbore_in_s = clamp(bore_in_s, -2.0, 2.0);\npoke(bore, bore_in_s, wi, 0);\n\nbore_wi = wi + 1;\nif (bore_wi >= 8192) { bore_wi = 0; }\n\n\n// ==========================================================\n// Bell biquad -- POST-LOOP radiation filter (Direct Form I)\n//   rad_out = b0*x + b1*x1 + b2*x2 - a1*y1 - a2*y2\n// Shapes the output timbre without affecting bore tuning.\n// ==========================================================\nrad_in = bore_return + reed_filt;  // reed honk summed post-loop\nrad_out = b0 * rad_in\n        + b1 * bell_x1\n        + b2 * bell_x2\n        - a1 * bell_y1\n        - a2 * bell_y2;\nbell_x2 = bell_x1;\nbell_x1 = rad_in;\nbell_y2 = bell_y1;\nbell_y1 = rad_out;\n\n\n// ==========================================================\n// Output -- biquad-filtered bore radiation\n// ==========================================================\nout1 = rad_out;\n",
          "numinlets": 2,
          "numoutlets": 1,
          "outlettype": [
            ""
          ],
          "patching_rect": [
