        "signal": false,
        "digest": "Bar length",
        "hot": false
      }
    ],
    "outlets": [
      {
        "id": 0,
        "type": "signal",
        "signal": true,
        "digest": "Phasor 0->1 at bar rate"
      },
      {
        "id": 1,
        "type": "signal",
        "signal": true,
        "digest": "Hard-sync / bar-wrap impulse"
      }
    ],
    "arguments": [],
    "messages": [],
    "attributes": {
